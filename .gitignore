# Build artifacts
**/__pycache__/
*.py[cod]

# Local data (dumps, storage blobs)
deploy/data/staging/
deploy/data/production/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Go binaries.
#
# `go build ./cmd/<name>` writes ./<name> into the SERVICE directory, so every
# cmd package is a binary that can land next to the source. This list was
# missing most of them — elitea-migrate, the two material installers, the auth
# validator and the index preflight — and a 13MB Mach-O got committed from a
# routine `go build ./cmd/elitea-migrate/` before scripts/no-binaries-check.sh
# would have caught it in CI. Keep one line per cmd package.
/services/*/cmd/*/__debug_bin*
/services/elitea-llm-gateway/elitea-llm-gateway
/services/elitea-main/cutover-ctl
/services/elitea-main/elitea-auth-material
/services/elitea-main/elitea-auth-validate
/services/elitea-main/elitea-main
/services/elitea-main/elitea-migrate
/services/elitea-main/elitea-runtime-material
/services/elitea-main/index-v2-preflight
/services/elitea-scheduler/elitea-scheduler
bin/
.claude/settings.json

# Local test artifacts for the no-binaries CI gate (scripts/no-binaries-check.sh)
fake-artifact.bin

# Generated mixed-deployment credentials, PKI, rendered Compose models and
# other machine-local runtime material.
/deploy/centry-hybrid/.runtime/

# Agent-loop working state (task tracker, learnings, run history) — local only
.ralph/

# Qwen Code memory and session state (local only)
.qwen/

# node_modules everywhere (including root-level)
node_modules/

# Vitest cache (can end up in node_modules/.vite/)
node_modules/.vite/

# Local standalone-stack mTLS material (deploy/scripts/gen-gateway-certs.sh)
deploy/certs/

# Go coverage profiles (task coverage / ci-go.yml write one per module)
coverage.out

# Vendored Helm subchart archives. `helm dependency build` recreates them from
# Chart.lock, which IS tracked; the .tgz files are build output and would trip
# scripts/no-binaries-check.sh.
deploy/helm/*/charts/*.tgz

# The vendored DeepWiki SPA's build output (ADR-0022 decision 8). The bundle is
# produced by elitea-main's Containerfile from the source in apps/deepwiki-ui;
# committing it would be a second artefact nobody rebuilds.
apps/deepwiki-ui/dist/

# Local screenshot scratch from browser validation runs; never committed.
.shots/
.shots-tmp/
