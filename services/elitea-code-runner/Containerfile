# syntax=docker/dockerfile:1.7
FROM rust:1.97.1-trixie@sha256:b1b3c9c0d921d7fa0a6d1f9ec7e4eab87f8c8ec97644c3d791450f131dec813f AS builder
WORKDIR /src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install cargo-auditable --locked --version 0.7.5
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY adapters/rust ./adapters/rust
# /target is shared by every build on the host and cargo judges local sources by
# mtime; touching /src under the lock compiles this context, not another
# checkout's (see services/elitea-worker-rust/Containerfile).
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/target,sharing=locked \
    find /src -type f -exec touch {} + && \
    CARGO_TARGET_DIR=/target cargo auditable build --locked --release -j 2 && \
    cp /target/release/elitea-code-runner /usr/local/bin/elitea-code-runner && \
    cp /target/release/elitea-code-execute /usr/local/bin/elitea-code-execute && \
    cp /target/release/elitea-code-rust /usr/local/bin/elitea-code-rust && \
    cp /target/release/elitea-code-rust-prepare /usr/local/bin/elitea-code-rust-prepare

# Minimal runner verification target. The Deno language target extends it below.
FROM python:3.12-slim-trixie@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f AS verification
COPY --from=builder /usr/local/bin/elitea-code-runner /usr/local/bin/elitea-code-runner
RUN mkdir -p /workspace/repository && chown -R 10001:10001 /workspace
WORKDIR /workspace
USER 10001:10001
CMD ["/usr/local/bin/elitea-code-runner"]


FROM denoland/deno:bin-2.5.4@sha256:1245e9856180be858aebeefdff2c3b98dc01e8ea667b48f4fb64647dc56bb61d AS deno
FROM verification AS deno-runtime
USER root
COPY --from=deno /deno /usr/local/bin/deno
COPY --from=builder /usr/local/bin/elitea-code-execute /usr/local/bin/elitea-code-execute
COPY adapters /opt/elitea-code
ENV DENO_DIR=/opt/deno-cache
RUN mkdir -p /opt/elitea-wheels && \
    deno cache --frozen --lock=/opt/elitea-code/deno.lock /opt/elitea-code/python.mjs /opt/elitea-code/javascript.mjs /opt/elitea-code/prepare_python_code.mjs /opt/elitea-code/javascript_preparation_job.mjs /opt/elitea-code/javascript_hydration_job.mjs && \
    deno run --no-config --no-prompt --deny-net \
      --allow-read=/opt/elitea-code --allow-write=/opt/elitea-code \
      /opt/elitea-code/prepare_javascript.mjs /opt/elitea-code/javascript-packages.json \
      /opt/elitea-code/javascript-dependencies.mjs && \
    deno cache --no-config --node-modules-dir=none --frozen=false \
      --lock=/opt/elitea-code/deno.lock /opt/elitea-code/javascript-dependencies.mjs && \
    deno run --frozen --lock=/opt/elitea-code/deno.lock --no-prompt \
      --allow-read=/opt/deno-cache,/opt/elitea-wheels,/opt/elitea-code \
      --allow-write=/opt/elitea-wheels --allow-env=NODE_DEBUG \
      --allow-net=cdn.jsdelivr.net,pypi.org,files.pythonhosted.org \
      /opt/elitea-code/preload.mjs /opt/elitea-wheels /opt/elitea-code/python-packages.json && \
    chmod -R a+rX /opt/deno-cache /opt/elitea-wheels /opt/elitea-code
USER 10001:10001


FROM builder AS rust-dependencies
COPY adapters/rust /opt/elitea-rust
RUN mkdir -p /opt/elitea-rust/.cargo && \
    cargo vendor --locked --manifest-path /opt/elitea-rust/Cargo.toml /opt/rust-vendor > /opt/elitea-rust/.cargo/config.toml

FROM builder AS rust-platform-dependencies
COPY adapters/rust/platform-v1.Cargo.toml /opt/elitea-rust-platform-v1/Cargo.toml
COPY adapters/rust/platform-v1.Cargo.lock /opt/elitea-rust-platform-v1/Cargo.lock
COPY adapters/rust/src/main_platform.rs /opt/elitea-rust-platform-v1/src/main.rs
COPY adapters/rust/src/platform.rs adapters/rust/src/platform_client.rs adapters/rust/src/platform_pipe.rs adapters/rust/src/user.rs /opt/elitea-rust-platform-v1/src/
RUN mkdir -p /opt/elitea-rust-platform-v1/.cargo && \
    cargo vendor --locked --manifest-path /opt/elitea-rust-platform-v1/Cargo.toml /opt/rust-platform-vendor > /opt/elitea-rust-platform-v1/.cargo/config.toml

FROM rust:1.97.1-trixie@sha256:b1b3c9c0d921d7fa0a6d1f9ec7e4eab87f8c8ec97644c3d791450f131dec813f AS rust-runtime
COPY --from=builder /usr/local/bin/elitea-code-runner /usr/local/bin/elitea-code-runner
COPY --from=builder /usr/local/bin/elitea-code-execute /usr/local/bin/elitea-code-execute
COPY --from=builder /usr/local/bin/elitea-code-rust /usr/local/bin/elitea-code-rust
COPY --from=builder /usr/local/bin/elitea-code-rust-prepare /usr/local/bin/elitea-code-rust-prepare
COPY --from=rust-dependencies /opt/elitea-rust /opt/elitea-rust
COPY --from=rust-dependencies /opt/rust-vendor /opt/rust-vendor
COPY --from=rust-platform-dependencies /opt/elitea-rust-platform-v1 /opt/elitea-rust-platform-v1
COPY --from=rust-platform-dependencies /opt/rust-platform-vendor /opt/rust-platform-vendor
RUN mkdir -p /workspace/repository && chown -R 10001:10001 /workspace
WORKDIR /workspace
USER 10001:10001
CMD ["/usr/local/bin/elitea-code-runner"]

# Preserve the default build as the Python/JavaScript/TypeScript runtime.
FROM deno-runtime AS default
