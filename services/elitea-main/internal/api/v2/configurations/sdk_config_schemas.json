  "openapi": {
    "title": "OpenApiConfiguration",
    "type": "object",
    "properties": {
      "api_key": {
        "type": "string",
        "title": "Api Key",
        "default": null,
        "description": "API key value (stored as a secret). Used when selecting 'API Key' authentication subsection.",
        "format": "password",
        "writeOnly": true
      },
      "auth_type": {
        "type": "string",
        "title": "Auth Type",
        "default": null,
        "description": "How to apply the API key. - 'Bearer': sets 'Authorization: Bearer <api_key>' - 'Basic': sets 'Authorization: Basic <api_key>' - 'custom': sets '<custom_header_name>: <api_key>'"
      },
      "custom_header_name": {
        "type": "string",
        "title": "Custom Header Name",
        "default": null,
        "description": "Custom header name to use when auth_type='custom' (e.g. 'X-Api-Key')."
      },
      "client_id": {
        "type": "string",
        "title": "Client Id",
        "default": null,
        "description": "OAuth2 client ID (also known as Application ID or App ID)"
      },
      "client_secret": {
        "type": "string",
        "title": "Client Secret",
        "default": null,
        "description": "OAuth2 client secret (stored securely)",
        "format": "password",
        "writeOnly": true
      },
      "token_url": {
        "type": "string",
        "title": "Token Url",
        "default": null,
        "description": "OAuth2 token endpoint URL for obtaining access tokens. Examples: Azure AD: https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token, Google: https://oauth2.googleapis.com/token, Auth0: https://{domain}/oauth/token, Spotify: https://accounts.spotify.com/api/token",
        "format": "password",
        "writeOnly": true
      },
      "scope": {
        "type": "string",
        "title": "Scope",
        "default": null,
        "description": "OAuth2 scope(s), space-separated if multiple (per OAuth2 RFC 6749). Examples: \"user-read-private user-read-email\" (Spotify), \"api://app-id/.default\" (Azure), \"https://www.googleapis.com/auth/cloud-platform\" (Google)"
      },
      "method": {
        "type": "string",
        "title": "Method",
        "default": null,
        "description": "Token exchange method for client credentials flow. 'default': Sends client_id and client_secret in POST body (Azure AD, Auth0, most providers). 'Basic': Sends credentials via HTTP Basic auth header - required by Spotify, some AWS services, and certain OAuth providers."
      }
    },
    "metadata": {
      "label": "OpenAPI",
      "icon_url": "openapi.svg",
      "categories": [
        "integrations"
      ],
      "type": "openapi",
      "extra_categories": [
        "api",
        "openapi",
        "swagger"
      ],
      "check_connection": {
        "enabled_when": {
          "all_fields_set": [
            "client_id",
            "client_secret",
            "method",
            "token_url"
          ]
        },
        "disabled_tooltip": "Available only for OAuth (Client Credentials). Please setup client_id, client_secret, method and token_url to activate it on setup."
      },
      "sections": {
        "auth": {
          "required": false,
          "subsections": [
            {
              "name": "API Key",
              "fields": [
                "api_key",
                "auth_type",
                "custom_header_name"
              ]
            },
            {
              "name": "OAuth",
              "fields": [
                "client_id",
                "client_secret",
                "token_url",
                "scope",
                "method"
              ]
            }
          ]
        }
      },
      "section": "credentials"
    }
  },
