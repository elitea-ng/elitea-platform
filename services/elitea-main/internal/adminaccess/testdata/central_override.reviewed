# The central override of ADR-0059 R0.6b: the (route, configuration type) pairs
# a holder of projects.settings.view or projects.settings.manage reaches in a
# project it is not a member of. One line per pair:
#   METHOD PATTERN CONFIGURATION_TYPE CENTRAL_PERMISSION
#
# A pair is added to internal/adminaccess/central_override.go and to this file
# in the same change, after a security review of what the type controls. A
# credential, model or toolkit configuration type never belongs here: the
# override reaches the five guarded project settings and nothing else.

GET /api/v2/configurations/configurations/{projectID} ai_disclosure projects.settings.view
GET /api/v2/configurations/configurations/{projectID} browser projects.settings.view
GET /api/v2/configurations/configurations/{projectID} cloud_executor projects.settings.view
GET /api/v2/configurations/configurations/{projectID} computer_use projects.settings.view
GET /api/v2/configurations/configurations/{projectID} worker_egress projects.settings.view
GET /api/v2/configurations/configurations/{mode}/{projectID} ai_disclosure projects.settings.view
