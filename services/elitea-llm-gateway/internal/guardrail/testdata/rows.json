      {"name": "classifier", "type": "http", "action": "flag", "url": "https://classifier.example.com/v1/check", "auth_header": "X-Api-Key", "auth_secret": "{{secret.CLASSIFIER_KEY}}", "labels": ["toxicity"], "min_score": 0.7}
    ]}}},
    {"name": "top-level shape is refused", "valid": false, "data": {"stage": "output", "detectors": [{"type": "secrets", "action": "flag"}]}},
