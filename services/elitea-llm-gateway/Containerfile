# syntax=docker/dockerfile:1.7
#
# elitea-llm-gateway is a STANDALONE Go module that needs Go 1.26.4 or above
# (required by github.com/maximhq/bifrost/core). It is deliberately NOT part of
# the root go.work workspace — that workspace stays on Go 1.25.8 for elitea-main
# and elitea-scheduler, whose toolchain must not be bumped.
#
# ── THE BUILD CONTEXT IS THE REPOSITORY ROOT ─────────────────────────────────
#
# It was this module directory. That stopped being possible when the module
# added `replace .../libs/go/egresslib => ../../libs/go/egresslib`: the replace
# target sits OUTSIDE the module directory, so `go mod download` failed with
# "reading /libs/go/egresslib/go.mod: no such file or directory" before any Go
# source was read. elitea-scheduler, elitea-worker-python and elitea-worker-rust
# already build from the root for the same reason.
#
# Nothing about the toolchain changes with the wider context. go.work is NOT
# copied into the image, and the build below still sets GOWORK=off, so the
# workspace toolchain is not consulted whether or not the file is reachable
# from the context. `golang:1.26-alpine` below remains the only toolchain here.
#
# Every caller passes the root: .github/workflows/ci-image-scan.yml,
# .github/workflows/publish.yml, docker-bake.hcl, Taskfile.yml (images:gateway)
# and deploy/docker-compose.standalone-full.yml.
#
# The tag was `golang:1.26.4-alpine`. An exact patch pin freezes the Go standard
# library, and the standard library gets CVEs like any other package: the scan
# in ci-image-scan.yml reported 9 HIGH findings against stdlib v1.26.4, all
# fixed in 1.26.6 (#433). `golang:1.26-alpine` still satisfies the 1.26.4
# minimum and takes each patch release, which is what elitea-main and
# elitea-scheduler already do with `golang:1.25-alpine`.
FROM golang:1.26-alpine AS builder
WORKDIR /src

# Cache module downloads separately from source.
#
# The local `replace` target must be present BEFORE `go mod download` runs: the
# command reads the replace directive and opens the replaced module's go.mod.
COPY libs/go/egresslib ./libs/go/egresslib
COPY services/elitea-llm-gateway/go.mod services/elitea-llm-gateway/go.sum ./services/elitea-llm-gateway/
WORKDIR /src/services/elitea-llm-gateway
# A TRANSIENT proxy.golang.org failure must not fail the build.
#
# Observed in CI: `read "https://proxy.golang.org/.../@v/vX.Y.Z.zip": stream
# error: stream ID 509; INTERNAL_ERROR; received from peer` — the proxy
# accepted the request and then broke the HTTP/2 stream mid-body. Go does not
# retry that on its own, and `direct` is not a fallback for it either: Go falls
# through to `direct` on a 404/410 from the proxy, never on a broken stream.
#
# So the retry is here, bounded and LOUD. Each failure prints, so a permanent
# error — a module that genuinely does not exist — is five identical messages
# and a non-zero exit rather than a silent stall.
#
# The cache mount is what makes a retry cheap: without it every attempt
# re-downloads the whole module graph. It is BuildKit scratch space and NOT a
# layer cache — it cannot make a stale layer be reused, and the module cache is
# content-addressed and verified against go.sum — so it does not weaken
# ci-web-e2e.yml's recorded "no buildx/gha layer cache here on purpose".
# `go build` below mounts the same cache; without that the modules this step
# fetched would not be visible to it.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    for attempt in 1 2 3 4 5; do \
        go mod download && exit 0; \
        echo "go mod download failed (attempt ${attempt}/5)" >&2; \
        sleep $((attempt * 5)); \
    done; \
    echo "go mod download failed after 5 attempts" >&2; \
    exit 1

COPY services/elitea-llm-gateway/ ./

ARG TARGETOS=linux
ARG TARGETARCH=amd64
# VERSION is declared for build-time labelling only; no version symbol exists in
# the source tree, so it is NOT injected via -X.
ARG VERSION=dev
# GOFLAGS=-mod=mod keeps the standalone module build independent of any parent
# go.work the host may set; GOWORK=off guarantees the workspace is not consulted.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOWORK=off GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/elitea-llm-gateway ./cmd/elitea-llm-gateway

# ── final runtime image ───────────────────────────────────────────────────────
#
# A `FROM aquasec/trivy:latest AS scanner` stage stood here. No stage copied
# from it, and a builder only builds the stages its target needs, so the stage
# was pruned from every build graph and the scan never ran once (#433). It is
# the same defect #224 recorded in services/elitea-main/Containerfile.
#
# The scan is a job in .github/workflows/ci-image-scan.yml now. That job scans
# the image this file produces, prints every finding, and fails when the report
# holds no Go binary — so a scan that stops running cannot look like a clean one.
FROM gcr.io/distroless/static-debian12:nonroot AS final
COPY --from=builder /out/elitea-llm-gateway /elitea-llm-gateway
# distroless contains no shell, wget, or curl, so a CMD/CMD-SHELL HEALTHCHECK
# cannot be used. Kubernetes MUST configure httpGet probes against :8083/healthz
# (liveness) and :8083/readyz (readiness) instead of relying on Docker's
# HEALTHCHECK.
HEALTHCHECK NONE
EXPOSE 8083
ENTRYPOINT ["/elitea-llm-gateway"]
