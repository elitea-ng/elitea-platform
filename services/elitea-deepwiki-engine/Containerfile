# syntax=docker/dockerfile:1.7
#
# The Rust-native DeepWiki engine (ADR-0026): one static-ish binary on a
# distroless base. No Python, no ML closure, no shell.
#
# Build from the repository root (the context must be the root: see the
# migrations COPY below):
#   docker buildx bake elitea-deepwiki-engine-native
#   podman build -f services/elitea-deepwiki-engine/Containerfile -t elitea-deepwiki-engine-native .
#
# Released as ghcr.io/elitea-ng/elitea-deepwiki-engine-native (ADR-0026
# phase 7): docker-bake.hcl, publish.yml's build / scan / publish-image
# matrices and IMAGES array, and ci-image-scan.yml name it together, and
# scripts/ci/image-matrix.sh holds them in step.

# Debian 13 (trixie) throughout, the release every image in this repository
# is based on. The runtime keeps glibc and CA roots and has NO system OpenSSL:
# the engine's TLS is rustls (reqwest, gix), so OpenSSL would only be a
# scanned package that nothing loads. The one other library the binary needs,
# libgcc_s, comes from distroless cc-debian13 with its package record and
# licence, as the worker's image does it.
FROM gcr.io/distroless/cc-debian13:nonroot AS runtime-cc
FROM rust:1.99.1-trixie@sha256:767c71592f7d1f3f242292000f8efd4e67b6732363da176772f4d220332e264f AS runtime-libraries
COPY --from=runtime-cc /usr/lib/ /cc-lib/
COPY --from=runtime-cc /var/lib/dpkg/status.d/libgcc-s1* /runtime-files/var/lib/dpkg/status.d/
COPY --from=runtime-cc /var/lib/dpkg/status.d/gcc-14-base* /runtime-files/var/lib/dpkg/status.d/
COPY --from=runtime-cc /usr/share/doc/gcc-14-base/ /runtime-files/usr/share/doc/gcc-14-base/
COPY --from=runtime-cc /usr/share/lintian/overrides/libgcc-s1 /runtime-files/usr/share/lintian/overrides/libgcc-s1
RUN cd /cc-lib && \
    set -- */libgcc_s.so.1 && test "$#" -eq 1 && test -f "$1" && \
    mkdir -p /runtime-files/usr/lib && cp --parents "$1" /runtime-files/usr/lib && \
    ln -s gcc-14-base /runtime-files/usr/share/doc/libgcc-s1

FROM gcr.io/distroless/base-nossl-debian13:nonroot AS runtime-base
COPY --from=runtime-libraries /runtime-files/ /

FROM rust:1.99.1-trixie@sha256:767c71592f7d1f3f242292000f8efd4e67b6732363da176772f4d220332e264f AS toolchain
# A transient GitHub/crates.io failure must not fail the build: cargo's
# built-in libgit2 fetch gave up on one TLS error ("SSL error: unknown error",
# then "revision ... not found") for a pinned tree-sitter git dependency in
# CI. The git CLI and more retries ride over it; the lockfile still pins
# every revision and checksum.
ENV CARGO_NET_RETRY=10 \
    CARGO_NET_GIT_FETCH_WITH_CLI=true

# `cargo auditable` embeds the dependency list trivy's `rustbinary` analyzer
# reads; without it an image scan sees only the Debian base (see the
# worker's Containerfile). Installed before any source is copied, so a
# source change does not rebuild the tool.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    flock /usr/local/cargo/registry/.elitea-fetch.lock cargo install cargo-auditable --locked --version 0.7.5

WORKDIR /src/services/elitea-deepwiki-engine

# The build context's sources, laid out under /src, in ONE place: the
# planner and the builder both copy this stage's /src, so the two cannot
# drift apart.
FROM scratch AS sources
# The shared engine crates are path dependencies at ../../libs/rust, so the
# repository layout is kept under /src (ADR-0027); the engine sidecar's
# build.rs reads ../../libs/proto (elitea.engine.v1, #1359).
COPY libs/proto /src/libs/proto
COPY libs/rust /src/libs/rust
COPY services/elitea-deepwiki-engine /src/services/elitea-deepwiki-engine

# The dependency skeleton: every local manifest, the lockfile, no sources
# (libs/rust/scripts/cargo-dependency-skeleton.py; the worker's Containerfile
# carries the full note). It is a function of the manifests alone, so the
# dependency layer below is reused across every source-only change.
FROM toolchain AS planner
COPY --from=sources /src/ /src/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    flock /usr/local/cargo/registry/.elitea-fetch.lock python3 /src/libs/rust/scripts/cargo-dependency-skeleton.py . /skeleton

FROM toolchain AS builder
# Optional build-only concurrency bound for shared development hosts.
ARG CARGO_BUILD_JOBS
# Every registry and git dependency, compiled into THIS layer from the
# lockfile, by the same `cargo auditable build --frozen --release` as the real
# build below, so the real build finds them fresh.
# The registry/git mounts are SHARED between images, and cargo's own package
# lock lives outside them, so two images building at once unpacked the same
# crate together ("failed to unpack package ... .cargo-ok", run 39433053742 on
# PR #1328). `flock` on a file INSIDE the mount serialises the download and
# unpack only (the skeleton's `cargo metadata` too); the compiles run
# `--frozen` (no network, no registry writes) in parallel.
COPY --from=planner /skeleton/ /src/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    flock /usr/local/cargo/registry/.elitea-fetch.lock cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')" && \
    CARGO_TARGET_DIR=/build-target cargo auditable build --frozen --release

COPY --from=sources /src/ /src/

# Cargo judges a path crate fresh by mtime, and COPY keeps the build context's
# mtimes, which can be OLDER than the placeholder build above: a placeholder
# would then look up to date and ship. Touching /src first recompiles every
# local crate from this context; the registry crates stay as built. The target
# directory is removed in the same step, so this layer holds the binary and
# not a second copy of the dependency build.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    find /src -type f -exec touch {} + && \
    flock /usr/local/cargo/registry/.elitea-fetch.lock cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')" && \
    CARGO_TARGET_DIR=/build-target cargo auditable build --frozen --release && \
    cp /build-target/release/elitea-deepwiki-engine /usr/local/bin/elitea-deepwiki-engine && \
    rm -rf /build-target

# Resolve every library the binary needs against the runtime image, without
# starting it: no system OpenSSL linked or shipped, CA roots present, and the
# whole closure found inside the runtime root. A base change that drops a
# library fails HERE, not as a sidecar that cannot start.
# The script is shared (libs/rust/scripts), already in the builder with the libs.
RUN --mount=type=bind,from=runtime-base,source=/,target=/runtime-root,readonly \
    sh /src/libs/rust/scripts/verify-runtime.sh /usr/local/bin/elitea-deepwiki-engine

# The socket directory, built here because the runtime image has no shell.
# A compose named volume (and Docker's fresh volume in particular) takes the
# IMAGE path's ownership on first mount; without the directory in the image
# it arrives root:root 0755, uid 10001 cannot bind the socket, the engine is
# never healthy, and the Go host and elitea-main that wait on it never start.
# World-writable, as the Python engine image makes it: the Go host connects
# as another uid. The Python image's Containerfile carries the same rule.
RUN mkdir -p /socket-dir/run/deepwiki && chmod 0777 /socket-dir/run/deepwiki

FROM runtime-base AS runtime

COPY --from=builder /usr/local/bin/elitea-deepwiki-engine /usr/local/bin/elitea-deepwiki-engine
COPY --from=builder --chown=10001:10001 /socket-dir/run/ /run/

# The socket is created world-writable inside a directory only the pod (or
# the compose project) shares, so the Go host — another non-root user — can
# connect. The probe is the binary itself (`elitea-deepwiki-engine
# healthcheck`), because distroless has no shell; compose and Helm declare
# it, since an OCI image carries no HEALTHCHECK.
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/elitea-deepwiki-engine"]
CMD ["serve"]
