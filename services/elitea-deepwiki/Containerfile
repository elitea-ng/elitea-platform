# ELITEA DeepWiki provider service.
#
# The engine SOURCE is always in the image — it is part of the package. Its
# ~92-package dependency CLOSURE (torch, transformers, faiss-cpu, tree-sitter
# grammars) is not, unless EXTRAS asks for it:
#
#   podman build -f services/elitea-deepwiki/Containerfile -t elitea-deepwiki .
#   podman build -f services/elitea-deepwiki/Containerfile \
#       --build-arg EXTRAS="[engine,storage-postgres]" \
#       -t elitea-deepwiki:engine .
#
# The default build stays small and CI-buildable; the engine build is
# torch-sized, which is why ADR-0022 keeps it out of the default bake group.
# A container without the closure still serves the whole SPI and refuses every
# tool — it cannot silently look like it has an engine, because
# ELITEA_DEEPWIKI_RUNNER defaults to the refusing runner and GET /health says
# which runner is active.
#
# Build from the repository root.

FROM python:3.12.14-slim AS build
# The engine extra compiles pysqlite3 from source (no binary wheel on
# arm64, and none pinned for amd64 either), which needs a C compiler and
# the SQLite headers. Builder stage only: the runtime image copies wheels
# and never sees these packages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

ARG EXTRAS=""

WORKDIR /build
COPY services/elitea-deepwiki ./services/elitea-deepwiki

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip wheel \
      --no-cache-dir \
      --wheel-dir /wheels \
      "./services/elitea-deepwiki${EXTRAS}"

FROM python:3.12.14-slim AS runtime

# The base's remaining fixable packages, upgraded.
#
# MEASURED, not precautionary. The blocking image scan reported 73 HIGH and
# CRITICAL findings on the previous base (python:3.12.10-slim, Debian 12.11),
# every one of them from the Debian layer and none from this project's own
# packages. Moving to 3.12.14-slim (Debian 13, trixie) takes that to 19, and
# these three packages are the only ones of the nineteen that Debian has a
# fixed version for — CVE-2026-14456, fixed in openssl 3.5.7-1~deb13u2.
#
# The survivors have no fix in Debian at all. They are recorded in
# .github/image-scan-exempt.txt with the issue that ends the entry, and the
# count there is re-measured on each base bump (#636).
#
# --only-upgrade, so this installs nothing new: a package that is not already
# in the base is not pulled in by naming it here.
#
# THE `ADD` BELOW IS NOT A FILE THE IMAGE NEEDS. It is a cache stamp.
#
# The upgrade is a layer, and its command string never changes. Both
# ci-image-scan.yml and publish.yml build with `cache-from: type=gha`, so
# BuildKit serves that layer from cache on every build and the image keeps the
# package versions of the day the layer was FIRST built. The same defect was
# measured on the nginx image and is recorded in apps/elitea-web/Containerfile:
# the build log said `CACHED` in one word, and "takes the fixes on the day WE
# build" was true of the source and false of the build. A number measured that
# way describes a layer that did not re-run.
#
# BuildKit re-resolves a remote source on every build and keys the layer on
# what it fetched. The Debian release files are the indexes apt reads, so the
# upgrade below is invalidated exactly when Debian publishes new packages, and
# never otherwise. apt never reads these copies.
#
# THE SUITE NAMES MUST MOVE WITH THE BASE. The RUN asserts the codename, so a
# base bump to a new Debian release FAILS the build instead of leaving the
# stamp to watch a suite this image does not install from.
ADD https://deb.debian.org/debian/dists/trixie/InRelease /usr/share/debian-index-stamp/trixie
ADD https://deb.debian.org/debian/dists/trixie-updates/InRelease /usr/share/debian-index-stamp/trixie-updates
ADD https://deb.debian.org/debian-security/dists/trixie-security/InRelease /usr/share/debian-index-stamp/trixie-security
RUN . /etc/os-release \
    && if [ "${VERSION_CODENAME}" != "trixie" ]; then \
         echo "base is Debian ${VERSION_CODENAME}, the cache stamp watches trixie — update the ADD lines above" >&2; \
         exit 1; \
       fi \
    && apt-get update \
    && apt-get install --no-install-recommends --only-upgrade -y \
         openssl libssl3t64 openssl-provider-legacy \
    && rm -rf /var/lib/apt/lists/*

# Non-root by default; the service needs no privileged capability and its
# scratch directory is ephemeral pod storage (ADR-0022 decision 4).
RUN useradd --create-home --uid 10001 deepwiki \
    && mkdir -p /var/scratch/deepwiki \
    && chown deepwiki:deepwiki /var/scratch/deepwiki

ARG EXTRAS=""

# The engine clones with the git CLI (subprocess, not a library), so the
# engine build carries git; the default build does not — its runner refuses
# every tool and would never clone. MEASURED: the first real-engine run
# through the host failed at `[Errno 2] No such file or directory: 'git'`.
RUN case "${EXTRAS}" in *engine*) \
      apt-get update \
      && apt-get install -y --no-install-recommends git \
      && rm -rf /var/lib/apt/lists/* ;; \
    esac

# The engine's ask/research answer over the UnifiedWikiDB (sqlite-vec) the
# indexer writes; the classic path they take WITHOUT this flag loads a FAISS
# cache the indexer stopped building ("Skipping legacy vectorstore build
# (UnifiedWikiDB only)"), so every question answered `No wiki index found`
# beside a freshly generated wiki. Every legacy deployment sets it
# (legacy/deploy/*/pylon_deepwiki: DEEPWIKI_ASK_AGENTIC "1"); here it is the
# image default so a chart, a compose file or a kind stack cannot forget it.
# MEASURED on the first real-engine chat through the product (DWIKI-014b).
ENV DEEPWIKI_ASK_AGENTIC=1

COPY --from=build /wheels /wheels
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-cache-dir --no-index --find-links /wheels \
      "elitea-deepwiki${EXTRAS}" \
    && rm -rf /wheels

# The engine sidecar's socket directory (ADR-0023 H2). Created here, owned
# by the service user and world-writable, because a compose named volume
# and a fresh bind mount take the IMAGE path's ownership on first mount —
# without this the directory arrives root-owned, uvicorn cannot bind the
# socket as uid 10001, and the container is "unhealthy" with nothing in its
# log but the bind error. The Go host in the same pod connects as another
# uid, which needs traverse on the directory and write on the socket file
# (the sidecar creates it with umask 0).
RUN mkdir -p /run/deepwiki && chown deepwiki:deepwiki /run/deepwiki && chmod 0777 /run/deepwiki

USER deepwiki
WORKDIR /home/deepwiki

ENV ELITEA_DEEPWIKI_SCRATCH_PATH=/var/scratch/deepwiki \
    PYTHONUNBUFFERED=1

# No port: the entrypoint is the engine SIDECAR (ADR-0023), which listens on
# the Unix socket ELITEA_DEEPWIKI_ENGINE_SOCKET for the Go sub-application
# host in the same pod. The provider SPI is that host's.
#
# The settings object is strict-parsed at startup, so a malformed environment
# fails the container rather than degrading a request later.
ENTRYPOINT ["python", "-m", "elitea_deepwiki"]
