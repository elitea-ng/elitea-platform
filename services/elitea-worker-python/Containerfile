# Debian 13 (trixie), not the Debian 12 (bookworm) this image used to sit on.
# This is the OS half of #554, and the honest report of it is:
#
#   * The finding count barely moves. MEASURED with the scan job's own trivy
#     invocation, on cold local builds of both: bookworm 84 HIGH/CRITICAL lines,
#     trixie 82. NEITHER set has a single published fixed version, so no branch
#     here clears either one. Do not read this bump as "the OS half is solved".
#   * What it does buy is not in the scan. CPython is BUILT FROM SOURCE in these
#     images, so it is not in the Debian package database and trivy never reads
#     its version. 3.12.14 is four CPython patch releases past 3.12.10, and that
#     difference is invisible to the count above in both directions.
#   * It also gives the three Python images one base. services/elitea-deepwiki
#     and services/elitea-inventory are already on python:3.12.14-slim, so one
#     Debian release, one stamp suite and one upgrade posture now cover all
#     three.
#
# The runtime probes are what say the move is safe rather than only smaller:
# `require_indexing_runtime_capabilities()` runs in the build below and drives
# the real Tesseract, Poppler and Cairo of THIS base.
FROM python:3.12.14-slim AS build

ARG ELITEA_SDK_REVISION=b5113a129329b85d23c2d5c2bf55f18e307414ec
ARG ELITEA_SDK_ARCHIVE_SHA256=df398b4a378e7b88ea3b72511e31de13a17a02159c69fbada6f0b948a0ecf2d7
ARG ELITEA_SDK_MCP_PREFLIGHT_PATCH=5c9409779ac0a55f8bf74f6ef438977089187a14
ARG ELITEA_SDK_MCP_HARD_TIMEOUT_PATCH=07ddc5cd67a0c747f83ca0e26421cde71bd97d9d
ARG ELITEA_SDK_VERSION=0.9.8

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      build-essential \
      git \
      libcairo2-dev \
      libpango1.0-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY libs/proto ./libs/proto
COPY services/elitea-worker-python ./services/elitea-worker-python
RUN git clone \
      --filter=blob:none \
      --no-checkout \
      https://github.com/EliteaAI/elitea-sdk.git \
      ./elitea-sdk \
    && git -C ./elitea-sdk checkout --detach "${ELITEA_SDK_REVISION}" \
    && test "$(git -C ./elitea-sdk archive --format=tar HEAD | sha256sum | cut -d ' ' -f 1)" = "${ELITEA_SDK_ARCHIVE_SHA256}" \
    && git -C ./elitea-sdk cat-file -e "${ELITEA_SDK_MCP_PREFLIGHT_PATCH}^{commit}" \
    && git -C ./elitea-sdk cat-file -e "${ELITEA_SDK_MCP_HARD_TIMEOUT_PATCH}^{commit}" \
    && git -C ./elitea-sdk cherry-pick --no-commit "${ELITEA_SDK_MCP_PREFLIGHT_PATCH}" \
    && git -C ./elitea-sdk cherry-pick --no-commit "${ELITEA_SDK_MCP_HARD_TIMEOUT_PATCH}"
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip download \
      --dest /sources \
      --no-binary=:all: \
      --no-deps \
      "FigmaPy==2018.1.0" \
    && python ./services/elitea-worker-python/scripts/verify_locked_artifacts.py \
      ./services/elitea-worker-python/elitea-sdk.lock.json \
      /sources \
      verified_source_archives \
    && python -m pip wheel \
      --wheel-dir /wheels \
      --no-deps \
      /sources/FigmaPy-2018.1.0.tar.gz
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip wheel \
    --no-cache-dir \
    --wheel-dir /wheels \
    --no-deps \
    ./elitea-sdk \
    && test -f "/wheels/elitea_sdk-${ELITEA_SDK_VERSION}-py3-none-any.whl" \
    && python -m pip wheel \
    --wheel-dir /wheels \
    --find-links /wheels \
    --prefer-binary \
    "elitea-sdk @ file:///wheels/elitea_sdk-${ELITEA_SDK_VERSION}-py3-none-any.whl" \
    ./libs/proto \
    "./services/elitea-worker-python[agent-current,indexing-current]" \
    && python ./services/elitea-worker-python/scripts/verify_locked_artifacts.py \
      ./services/elitea-worker-python/elitea-sdk.lock.json \
      /wheels \
      verified_wheels

FROM python:3.12.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AZURE_DEVOPS_CACHE_DIR=/tmp/.azure-devops

# THE `ADD` BELOW IS NOT A FILE THE IMAGE NEEDS. It is a cache stamp.
#
# `apt-get upgrade --yes` is a layer, and its command string never changes.
# ci-image-scan.yml and publish.yml both build with `cache-from: type=gha`, so
# BuildKit serves that layer from cache on every build and the image keeps the
# package versions of the day the layer was FIRST built. The same defect was
# measured on the nginx image and is recorded in apps/elitea-web/Containerfile:
# the build log said `CACHED` in one word, and "takes the fixes on the day WE
# build" was true of the source and false of the build.
#
# BuildKit re-resolves a remote source on every build and keys the layer on
# what it fetched. The Debian release files are the indexes apt reads, so the
# upgrade below is invalidated exactly when Debian publishes new packages, and
# never otherwise. apt never reads these copies.
#
# THE SUITE NAMES MUST MOVE WITH THE BASE. The RUN asserts the codename, so a
# base bump to a new Debian release FAILS the build instead of leaving the
# stamp to watch a suite this image does not install from.
ADD https://deb.debian.org/debian/dists/trixie/InRelease /usr/share/debian-index-stamp/trixie
ADD https://deb.debian.org/debian/dists/trixie-updates/InRelease /usr/share/debian-index-stamp/trixie-updates
ADD https://deb.debian.org/debian-security/dists/trixie-security/InRelease /usr/share/debian-index-stamp/trixie-security
RUN . /etc/os-release \
    && if [ "${VERSION_CODENAME}" != "trixie" ]; then \
         echo "base is Debian ${VERSION_CODENAME}, the cache stamp watches trixie — update the ADD lines above" >&2; \
         exit 1; \
       fi \
    && apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
      libcairo2 \
      fonts-dejavu-core \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      poppler-utils \
      tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 elitea \
    && useradd --system --uid 10001 --gid elitea --home-dir /nonexistent --shell /usr/sbin/nologin elitea

COPY --from=build /wheels /wheels
COPY testdata/proto/runtime/v1 /opt/elitea/conformance
RUN python -m pip install \
    --no-cache-dir \
    --disable-pip-version-check \
    --no-index \
    --find-links /wheels \
    "elitea-worker-python[agent-current,indexing-current]==0.1.0" \
    && python -m pip check \
    && python -c "from elitea_worker.indexing_runtime_capabilities import require_indexing_runtime_capabilities; print('indexing-runtime-profile=' + require_indexing_runtime_capabilities())" \
    && python -c "from elitea_worker.agent_current_runtime_capabilities import require_agent_current_runtime_capabilities; print('agent-current-runtime-profile=' + require_agent_current_runtime_capabilities())" \
    && rm -rf /wheels

# The `pyodide` internal tool (#872): elitea_sdk's SandboxToolkit refuses to
# construct unless it finds SANDBOX_SERVICE_URL, or BOTH a `deno` executable
# on PATH and a PYODIDE_SANDBOX_PKG Deno entrypoint that exists. This image
# shipped none of those, so every agent's "Python sandbox" toggle silently did
# nothing on this worker. Install a pinned, digest verified `deno` binary —
# see scripts/install_pinned_deno.py for why this is a direct GitHub release
# download rather than an apt/pip package, and how the checksum gate keeps
# that an admitted download rather than an unpinned one.
ARG TARGETARCH=amd64
COPY services/elitea-worker-python/scripts/install_pinned_deno.py /tmp/install_pinned_deno.py
RUN python3 /tmp/install_pinned_deno.py --target-arch "${TARGETARCH}" --dest /usr/local/bin/deno \
    && rm -f /tmp/install_pinned_deno.py \
    && /usr/local/bin/deno --version

# The second half of #872: `deno` alone is not enough. `PyodideSandboxTool`
# also needs a Deno entrypoint script (PYODIDE_SANDBOX_PKG) that actually
# implements the sandbox — the SDK ships one, patched, at
# infra/data/sandbox/main.ts. Its content needs no separate pin: it is part of
# the exact SDK checkout the build stage already verified against
# ELITEA_SDK_ARCHIVE_SHA256, so copying it from that stage carries the same
# guarantee.
#
# main.ts statically imports npm:pyodide@0.29.0 and two jsr:@std packages —
# all three exact-versioned, never a bare `latest` — and `deno cache` resolves
# and caches that whole graph right here, at build time, when network access
# is expected and already used by every step above. That is what keeps every
# later `deno run` of this exact script from touching the network at all: the
# cache is content-addressed by exact URL+version, so a script that names
# exact versions is fully served from it. MEASURED: this adds one 8 MiB WASM
# runtime and a few hundred KB of TypeScript to the image, and nothing this
# admits ever downloads elitea_sdk-selected Python packages (pandas, numpy…)
# into the sandbox — the model's own code can `import` packages Pyodide does
# not bundle, and doing THAT is a genuine runtime network call the toolkit's
# own `allow_net` setting already gates; it is not something a build-time
# cache could remove.
#
# DENO_DIR/PYODIDE_SANDBOX_PKG are set here, as image-wide ENV, rather than
# left to elitea_worker.agents.internal_tools.ensure_sandbox_state_directories
# to default at runtime: MEASURED, a `deno run` of main.ts against this fully
# warmed, read-only cache needs no further write to DENO_DIR at all, so there
# is nothing for the per-run private-directory treatment SANDBOX_BASE gets to
# buy here — and baking the path means every deployment shape ships the same
# warm cache instead of re-resolving it, network-free or not, on first use.
ENV DENO_DIR=/opt/elitea/sandbox/deno-cache \
    PYODIDE_SANDBOX_PKG=/opt/elitea/sandbox/main.ts
COPY --from=build /build/elitea-sdk/infra/data/sandbox/main.ts /opt/elitea/sandbox/main.ts
RUN /usr/local/bin/deno cache --node-modules-dir=auto /opt/elitea/sandbox/main.ts \
    && chown -R 10001:10001 /opt/elitea/sandbox \
    && chmod -R go-w /opt/elitea/sandbox

USER 10001:10001
ENTRYPOINT ["elitea-worker"]
