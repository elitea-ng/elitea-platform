# syntax=docker/dockerfile:1.7

# Debian 13 (trixie) throughout, the release every image in this repository
# is based on. Keep the GCC runtime from the same Debian release, with its
# package records and licenses. Debian 13 is merged-/usr, so libgcc_s lives in
# /usr/lib/<triplet>/, and its base package is gcc-14-base (gcc-12-base on
# Debian 12). services/elitea-deepwiki-engine/Containerfile does the same.
FROM gcr.io/distroless/cc-debian13:nonroot AS runtime-cc
FROM rust:1.97.1-trixie AS runtime-libraries
COPY --from=runtime-cc /usr/lib/ /cc-lib/
COPY --from=runtime-cc /var/lib/dpkg/status.d/libgcc-s1* /runtime-files/var/lib/dpkg/status.d/
COPY --from=runtime-cc /var/lib/dpkg/status.d/gcc-14-base* /runtime-files/var/lib/dpkg/status.d/
COPY --from=runtime-cc /usr/share/doc/gcc-14-base/ /runtime-files/usr/share/doc/gcc-14-base/
COPY --from=runtime-cc /usr/share/lintian/overrides/libgcc-s1 /runtime-files/usr/share/lintian/overrides/libgcc-s1
RUN cd /cc-lib && \
    set -- */libgcc_s.so.1 && test "$#" -eq 1 && test -f "$1" && \
    mkdir -p /runtime-files/usr/lib && cp --parents "$1" /runtime-files/usr/lib && \
    ln -s gcc-14-base /runtime-files/usr/share/doc/libgcc-s1

# Rust TLS uses rustls. This base retains glibc and CA roots without system OpenSSL.
FROM gcr.io/distroless/base-nossl-debian13:nonroot AS runtime-base
COPY --from=runtime-libraries /runtime-files/ /

FROM rust:1.97.1-trixie AS builder-base

WORKDIR /src

# ── cargo-auditable IS INSTALLED BEFORE ANY SOURCE IS COPIED ────────────────
#
# It needs nothing from this repository — it is a pinned tool built from
# crates.io — so the only thing that may invalidate it is the base image.
# It used to sit BELOW the two COPY lines, which put it downstream of every
# byte of `services/elitea-worker-rust` and `libs/proto`: a one-line change to
# a spec in src/ rebuilt the tool as well as the crate. MEASURED on run
# 35606872334, `[elitea-worker builder 6/7]`: 44.0 s, on a pull request that
# had touched src/ and nothing else about this tool.
#
# Moving it above the COPYs costs nothing and makes that layer a function of
# the base image alone.
#
# `cargo auditable`, not plain `cargo`, and it is a SCAN requirement rather than
# a preference.
#
# A release Rust binary carries no record of what went into it. Trivy's
# `rustbinary` analyzer reads the audit-data section that cargo-auditable
# embeds, and finds nothing without it — so a scan of this image reports the
# distroless Debian base and stops there. Measured on this image: with
# cargo-auditable trivy returns two results, `debian` (os-pkgs) and
# `rustbinary` (lang-pkgs) covering all 418 crates; without it, only `debian`.
#
# That difference is the whole gate. `expect_type: rustbinary` in the two scan
# matrices FAILS a report that never reached the application content, which is
# what a scan of the base layers alone is. Dropping this line would not turn
# the scan red — it would make it pass while measuring the base image, which is
# the exact "absence reads as correctness" shape #433 was about.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo install cargo-auditable --locked --version 0.7.5

# Resolve every shipped ELF dependency against the final runtime without starting the application.
COPY <<'VERIFY' /usr/local/bin/verify-runtime
set -eu
artifact="$1"
readelf --sections --wide "$artifact" > /tmp/runtime-sections
grep -q '[.]debug_line ' /tmp/runtime-sections
grep -q '[.]symtab ' /tmp/runtime-sections
grep -q '[.]dep-v0 ' /tmp/runtime-sections
readelf --dynamic "$artifact" > /tmp/runtime-dynamic
if grep -Eq 'Shared library: \[(libssl|libcrypto)[.]' /tmp/runtime-dynamic; then
    echo 'System OpenSSL is not part of this runtime.' >&2
    exit 1
fi
test -z "$(find /runtime-root/var/lib/dpkg/status.d -name 'libssl*')"
test -z "$(find /runtime-root -name 'libssl.so*' -o -name 'libcrypto.so*')"
test -s /runtime-root/etc/ssl/certs/ca-certificates.crt
interpreter="$(readelf --program-headers --wide "$artifact" | sed -n 's/.*Requesting program interpreter: \(.*\)]/\1/p')"
test -n "$interpreter"
triplet="$(gcc -dumpmachine)"
"/runtime-root$interpreter" --inhibit-cache \
    --library-path "/runtime-root/lib/$triplet:/runtime-root/usr/lib/$triplet:/runtime-root/lib:/runtime-root/usr/lib" \
    --list "$artifact" > /tmp/runtime-libraries
cat /tmp/runtime-libraries
awk '$2 == "=>" && $3 !~ /^\/runtime-root\// { exit 1 }' /tmp/runtime-libraries
VERIFY

COPY libs/proto ./libs/proto
# The /llm caller contract crate (elitea-llm-wire) and the shared agent
# runtime (elitea-agent-runtime, ADR-0029) are path dependencies under
# ../../libs/rust, and so are the patched adk crates the worker's
# [patch.crates-io] names (libs/rust/vendor). The whole libs/rust workspace
# comes with them: the crates inherit their package fields and lints from
# libs/rust/Cargo.toml.
COPY libs/rust ./libs/rust
COPY services/elitea-worker-rust ./services/elitea-worker-rust

WORKDIR /src/services/elitea-worker-rust

FROM builder-base AS builder
# Optional build-only concurrency bound for shared development hosts.
ARG CARGO_BUILD_JOBS
# Optional rehearsal-only Cargo features, for example graph-extensions-rehearsal.
# Production images leave it empty.
ARG WORKER_REHEARSAL_FEATURES=""

# The dependency build lives in the THREE CACHE MOUNTS below, not in a layer,
# and that is deliberate: a cargo-chef style `target/` inside the image would
# be a multi-gigabyte builder layer in the `elitea-worker-rust-linux-amd64`
# GHA scope, and this repository's Actions cache was measured at 10.7 GB
# against a 10 GB cap (see .github/actions/build-stack-images) — the layer
# would evict the scopes it depends on. The mounts are the right home for it.
#
# They were simply not working: see the 391 KB restore recorded in that
# action's policy step. With the mount entry real, a pull request that touches
# only src/ recompiles the local crates (this one and vendor/*) and relinks,
# instead of building all 418 crates from an empty registry.
#
# ── EVERY LOCAL CRATE IS REBUILT; ONLY REGISTRY CRATES COME FROM THE CACHE ──
#
# /cargo-target is one mount for every build on a host: every worktree, the
# supervisor stage below and the DeepWiki engine. Cargo decides a path crate is
# fresh by comparing source mtimes with its last compile, and COPY keeps the
# build context's mtimes. A file last edited before ANOTHER checkout's build
# therefore looked older than that build, and the image shipped the other
# checkout's binary. `touch` puts every file under /src after any compile in the
# mount, so each local crate (this one, vendor/*, the libs/proto build script)
# is compiled from this context; registry and git crates are untouched.
# `sharing=locked` keeps a concurrent build from compiling or overwriting the
# binary between this step's touch and its copy.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/cargo-target,sharing=locked \
    find /src -type f -exec touch {} + && \
    CARGO_TARGET_DIR=/cargo-target cargo auditable build --locked --release \
      ${WORKER_REHEARSAL_FEATURES:+--features "$WORKER_REHEARSAL_FEATURES"} && \
    cp /cargo-target/release/elitea-worker-rust /usr/local/bin/elitea-worker-rust

# Check audit metadata, diagnostics, CA roots, and the complete runtime library closure.
RUN --mount=from=runtime-base,target=/runtime-root,readonly \
    sh /usr/local/bin/verify-runtime /usr/local/bin/elitea-worker-rust

FROM runtime-base AS runtime

COPY --from=builder \
    /usr/local/bin/elitea-worker-rust \
    /usr/local/bin/elitea-worker-rust

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/elitea-worker-rust"]

# Dedicated supervisor artifact. The default worker retains no Docker feature.
FROM builder-base AS supervisor-builder
# Optional build-only concurrency bound for shared development hosts.
ARG CARGO_BUILD_JOBS
# Local sources are touched under the lock for the reason given in `builder`.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/cargo-target,sharing=locked \
    find /src -type f -exec touch {} + && \
    CARGO_TARGET_DIR=/cargo-target cargo auditable build --locked --release \
      --features sandbox-supervisor --bin elitea-sandbox-supervisor && \
    cp /cargo-target/release/elitea-sandbox-supervisor /usr/local/bin/elitea-sandbox-supervisor

RUN --mount=from=runtime-base,target=/runtime-root,readonly \
    sh /usr/local/bin/verify-runtime /usr/local/bin/elitea-sandbox-supervisor

FROM runtime-base AS supervisor
COPY --from=supervisor-builder /usr/local/bin/elitea-sandbox-supervisor /usr/local/bin/elitea-sandbox-supervisor
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/elitea-sandbox-supervisor"]

# Preserve the existing default image target.
FROM runtime AS default
