# syntax=docker/dockerfile:1.7
#
# Build context is the REPO ROOT (see deploy/docker-compose.yml,
# docker-bake.hcl, .github/workflows/publish.yml) — issue #250 added a
# `replace github.com/EliteaAI/elitea-platform/libs/go/observability =>
# ../../libs/go/observability` to go.mod, which needs that directory reachable
# from the build context; a context scoped to services/elitea-scheduler alone
# cannot see it. Mirrors services/elitea-main/Containerfile's builder stage.
FROM golang:1.25-trixie AS builder
WORKDIR /src
COPY libs/go/observability ./libs/go/observability
# The NATS client identity helper (#1076), the module's second local replace.
COPY libs/go/natsconn ./libs/go/natsconn
COPY services/elitea-scheduler/go.mod services/elitea-scheduler/go.sum ./services/elitea-scheduler/
WORKDIR /src/services/elitea-scheduler
# A TRANSIENT proxy.golang.org failure must not fail the build.
#
# Observed in CI: `read "https://proxy.golang.org/.../@v/vX.Y.Z.zip": stream
# error: stream ID 509; INTERNAL_ERROR; received from peer` — the proxy
# accepted the request and then broke the HTTP/2 stream mid-body. Go does not
# retry that on its own, and `direct` is not a fallback for it either: Go falls
# through to `direct` on a 404/410 from the proxy, never on a broken stream.
#
# So the retry is here, bounded and LOUD. Each failure prints, so a permanent
# error — a module that genuinely does not exist — is five identical messages
# and a non-zero exit rather than a silent stall.
#
# The cache mount is what makes a retry cheap: without it every attempt
# re-downloads the whole module graph. It is BuildKit scratch space and NOT a
# layer cache — it cannot make a stale layer be reused, and the module cache is
# content-addressed and verified against go.sum — so it does not weaken
# ci-web-e2e.yml's recorded "no buildx/gha layer cache here on purpose".
# `go build` below mounts the same cache; without that the modules this step
# fetched would not be visible to it.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    for attempt in 1 2 3 4 5; do \
        go mod download && exit 0; \
        echo "go mod download failed (attempt ${attempt}/5)" >&2; \
        sleep $((attempt * 5)); \
    done; \
    echo "go mod download failed after 5 attempts" >&2; \
    exit 1
COPY services/elitea-scheduler/ ./
ARG TARGETOS=linux
ARG TARGETARCH=amd64
# VERSION is declared for build-time labelling; no version symbol exists in the
# source tree, so it is NOT injected via -X (only stripped/optimised flags).
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/elitea-scheduler ./cmd/elitea-scheduler

FROM gcr.io/distroless/static-debian13:nonroot AS final
COPY --from=builder /out/elitea-scheduler /elitea-scheduler
# distroless contains no shell, wget, or curl, so a CMD/CMD-SHELL HEALTHCHECK
# cannot be used here.  Kubernetes deployments MUST configure an httpGet liveness
# probe against :8081/healthz instead of relying on Docker's HEALTHCHECK.
#
# NOTE FOR COMPOSE OWNER: deploy/docker-compose.yml currently declares
#   test: ["CMD-SHELL", "wget -qO- http://localhost:8081/healthz || exit 1"]
# for the elitea-scheduler service.  This will always fail on distroless because
# neither wget nor a shell is present in the image.  Replace it with an httpGet
# probe (docker compose does not support httpGet natively, so the simplest fix is
# to remove the healthcheck block and rely on k8s/upstream orchestration).
HEALTHCHECK NONE
EXPOSE 8081
ENTRYPOINT ["/elitea-scheduler"]
