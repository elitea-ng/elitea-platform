# ELITEA Inventory provider engine.
#
# The engine SOURCE is always in the image — it is part of the package. Its
# dependency CLOSURE (the ELITEA SDK's runtime and tools extras, networkx,
# igraph/leidenalg) is not, unless EXTRAS asks for it:
#
#   podman build -f services/elitea-inventory/Containerfile -t elitea-inventory .
#   podman build -f services/elitea-inventory/Containerfile \
#       --build-arg 'EXTRAS=[engine]' \
#       -t elitea-inventory:engine .
#
# A container without the closure still serves the whole sidecar protocol and
# refuses every tool — it cannot silently look like it has an engine, because
# ELITEA_INVENTORY_RUNNER defaults to the refusing runner and GET /engine/health
# says which runner is active.
#
# This image WAS multi-GB. Stage I8 replaced `elitea-sdk[runtime,tools]` with a
# bare `elitea-sdk` plus an exact set measured against what this service really
# imports, instantiates and runs (pyproject.toml states the ledger). The engine
# closure went from 356 packages to 126: torch and its NVIDIA CUDA wheels,
# torchvision, timm, transformers, sentence-transformers, unstructured,
# opencv-python and chromadb are all gone, and none of them was ever used here.
#
# The `tools` extra was NOT where they came from — `elitea-sdk[runtime]` alone
# resolves 255 packages and names chromadb itself. Dropping only `tools` would
# have removed neither chromadb nor torch.
#
# Build from the repository root.

FROM python:3.12.14-slim AS build

# The SDK's `tools` extra builds a handful of packages from source and links
# against cairo (the reporting toolkits). Builder stage only: the runtime image
# copies wheels and never sees the -dev packages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         gcc g++ libc6-dev libcairo2-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

ARG EXTRAS=""

WORKDIR /build
COPY services/elitea-inventory ./services/elitea-inventory

# The resolution is uv's; the WHEEL BUILDING is pip's.
#
# MEASURED, over six image builds, BEFORE I8: pip could not resolve the engine
# extra's closure in any reasonable time. The blanket SDK extras brought 356
# packages, and inside that set chromadb, mcp, langsmith, uvicorn[standard],
# unstructured-client and their h11/httpcore/websockets constraints formed a
# search space pip explored one metadata download at a time — every build was
# killed while it was still walking backwards through some package's release
# history. Pinning the offenders one at a time removed one dimension per build
# and revealed the next.
#
# uv resolved the same set, to the same versions, in about twenty seconds. So
# uv produces the lock and pip is given `--no-deps -r`, which asks it to build
# exactly what it is told and resolve nothing.
#
# I8 narrowed the closure to 126 packages, and pip CAN now resolve it — a plain
# `pip install -e '.[engine,test]'` completes on a developer machine, which is
# how the full 304-test suite was run against it. The split stays anyway: the
# `--no-deps -r` shape means a wheel that is missing is an error here rather
# than a silent fall back to a version nobody resolved, and that property is
# worth more than the one command it saves.
#
# The lock is generated HERE rather than committed, so it cannot go stale
# against pyproject.toml — the failure mode a checked-in lock has.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-cache-dir uv==0.9.5

RUN --mount=type=cache,target=/root/.cache/uv \
    cd services/elitea-inventory \
    && case "${EXTRAS}" in \
         *engine*) uv pip compile pyproject.toml --extra engine -o /tmp/requirements.txt ;; \
         *)        uv pip compile pyproject.toml -o /tmp/requirements.txt ;; \
       esac \
    && wc -l /tmp/requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip wheel \
      --no-cache-dir \
      --no-deps \
      --wheel-dir /wheels \
      -r /tmp/requirements.txt \
    && python -m pip wheel \
      --no-cache-dir \
      --no-deps \
      --wheel-dir /wheels \
      "./services/elitea-inventory"

FROM python:3.12.14-slim AS runtime

# The base's remaining fixable packages, upgraded — the same three
# services/elitea-deepwiki upgrades, for the same measured reason (the base's
# openssl is the only one of the base image's HIGH/CRITICAL findings that
# Debian trixie has a fixed version for). --only-upgrade, so this installs
# nothing new.
#
# THE `ADD` BELOW IS NOT A FILE THE IMAGE NEEDS. It is a cache stamp, and it is
# the same one services/elitea-deepwiki/Containerfile carries. The upgrade is a
# layer whose command string never changes, so a layer cache serves it on every
# build and freezes the package versions of the day it was first built. That
# defect was measured on the nginx image (apps/elitea-web/Containerfile).
# BuildKit re-resolves a remote source on every build, so the Debian release
# files invalidate the upgrade exactly when Debian publishes new packages. apt
# never reads these copies.
#
# THE SUITE NAMES MUST MOVE WITH THE BASE. The RUN asserts the codename, so a
# base bump to a new Debian release FAILS the build instead of leaving the
# stamp to watch a suite this image does not install from.
ADD https://deb.debian.org/debian/dists/trixie/InRelease /usr/share/debian-index-stamp/trixie
ADD https://deb.debian.org/debian/dists/trixie-updates/InRelease /usr/share/debian-index-stamp/trixie-updates
ADD https://deb.debian.org/debian-security/dists/trixie-security/InRelease /usr/share/debian-index-stamp/trixie-security
RUN . /etc/os-release \
    && if [ "${VERSION_CODENAME}" != "trixie" ]; then \
         echo "base is Debian ${VERSION_CODENAME}, the cache stamp watches trixie — update the ADD lines above" >&2; \
         exit 1; \
       fi \
    && apt-get update \
    && apt-get install --no-install-recommends --only-upgrade -y \
         openssl libssl3t64 openssl-provider-legacy \
    && rm -rf /var/lib/apt/lists/*

# Non-root by default; the service needs no privileged capability and its
# scratch directory is ephemeral pod storage.
RUN useradd --create-home --uid 10001 inventory \
    && mkdir -p /var/scratch/inventory \
    && chown inventory:inventory /var/scratch/inventory

ARG EXTRAS=""

# The engine build's runtime native libraries. cairo/pango are the SDK tools
# extra's; git is the source clone path some SDK repository wrappers shell out
# to. The default build carries none of them — its runner refuses every tool
# and would never clone or render anything. The same list
# services/elitea-worker-python installs, for the same SDK extras.
RUN case "${EXTRAS}" in *engine*) \
      apt-get update \
      && apt-get install -y --no-install-recommends \
           git libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
      && rm -rf /var/lib/apt/lists/* ;; \
    esac

# The wheels AND the lock they were built from. Installing `-r` the lock with
# --no-deps means this stage resolves nothing either: the versions are the ones
# uv chose in the builder, and a wheel that is missing is an error here rather
# than a silent fall back to a different version.
COPY --from=build /wheels /wheels
COPY --from=build /tmp/requirements.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-cache-dir --no-index --no-deps --find-links /wheels \
      -r /tmp/requirements.txt \
    && python -m pip install --no-cache-dir --no-index --no-deps --find-links /wheels \
      elitea-inventory \
    && rm -rf /wheels /tmp/requirements.txt

# The engine sidecar's socket directory. Created here, owned by the service
# user and world-writable, because a compose named volume and a fresh bind
# mount take the IMAGE path's ownership on first mount — without this the
# directory arrives root-owned, uvicorn cannot bind the socket as uid 10001,
# and the container is "unhealthy" with nothing in its log but the bind error.
# The Go host in the same pod connects as another uid, which needs traverse on
# the directory and write on the socket file (the sidecar creates it with
# umask 0). Measured on DeepWiki's first real sidecar run; the same mount
# shapes apply here.
RUN mkdir -p /run/inventory \
    && chown inventory:inventory /run/inventory \
    && chmod 0777 /run/inventory

USER inventory
WORKDIR /home/inventory

ENV ELITEA_INVENTORY_SCRATCH_PATH=/var/scratch/inventory \
    ELITEA_INVENTORY_ENGINE_SOCKET=/run/inventory/engine.sock \
    PYTHONUNBUFFERED=1

# No port: the entrypoint is the engine SIDECAR, which listens on the Unix
# socket ELITEA_INVENTORY_ENGINE_SOCKET for the Go sub-application host in the
# same pod. The provider SPI is that host's.
#
# The settings object is strict-parsed at startup, so a malformed environment
# fails the container rather than degrading a request later.
ENTRYPOINT ["python", "-m", "elitea_inventory"]
