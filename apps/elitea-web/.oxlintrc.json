{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Lint layer of record after decision D2: oxlint@1.75.0 host,
  // oxlint-tsgolint@7.0.2001 for type-aware rules (TS 7.0.2), local `elitea`
  // JS plugin for the §3.4 fences oxlint has no native rule for, and
  // eslint-plugin-i18next bridged through jsPlugins for R-T3.
  // Warning policy: every rule here is "error" or "off" — never "warn".
  // oxlint's config has no fail-on-warnings switch, so ci-web.yml passes
  // --deny-warnings on the lint invocation as a tripwire; revisit that flag
  // if any rule is ever set to warn.
  // Layer rules R-L1/L2/L3 are enforced by dependency-cruiser (D2), not here.
  // Every fence below is proven by scripts/check-gates-selftest.mjs fixtures.
  "plugins": ["react", "jsx-a11y", "import", "typescript", "unicorn", "oxc"],
  "jsPlugins": ["./tools/lint-rules/index.mjs", "eslint-plugin-i18next"],
  "options": {
    // Runs tsgolint for the typescript/* type-aware rules pinned below.
    // tsc --noEmit stays a separate gate (npm run typecheck); typeCheck is
    // deliberately off here so diagnostics are not double-reported.
    "typeAware": true
  },
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "parity/**",
    // Rule fixtures are deliberately-violating code, exercised only by
    // scripts/check-gates-selftest.mjs (which lints them per-case with this
    // same config, fixture-cwd-relative so the path-scoped overrides apply).
    "tools/lint-rules/fixtures/**",
    // The legacy DeepWiki reducer, SLICED VERBATIM out of the JSX by
    // scripts/deepwiki-oracle/extract-jsx-reducer.mjs so it can be run and
    // recorded. It is legacy code by definition — linting it would report the
    // findings of a file this repository is deleting, and "fixing" them would
    // make the differential compare against something the legacy app does not
    // do. Not committed either; see .gitignore.
    "scripts/deepwiki-oracle/jsxReducer.generated.mjs",
    // unit S4: orval-emitted output (tags-split endpoint/mock files + zod
    // models, including the scripted backfill for the handful orval's own
    // zod-schema writer misses — see scripts/lib/orval-zod-backfill.mjs).
    // Generated-code conventions apply (contract-tested per spec §6.3, not
    // line-linted); this is the same treatment vitest.config.ts's coverage
    // `exclude` already gives the directory. `mutator.ts` is deliberately
    // OUTSIDE both globs below (it sits directly in `generated/`, not under
    // a tag or `model/` subdirectory) — it is hand-written and stays linted.
    "src/shared/api/generated/*/*",
    "src/shared/api/generated/model/**",
    // unit S5: the socket contract (spec §5.5). These were generated until
    // #126 deleted the Go prototype socket.io server the generator read as a
    // required input; they are hand-maintained source now, and their unit
    // tests (events.test.ts / messages.test.ts) are the drift guard the
    // generator's --check used to be. They stay exempt for the one reason
    // that has not changed: they exceed max-lines purely because they
    // enumerate 43 events / 34 discriminants with evidence comments.
    "src/shared/api/socket/events.ts",
    "src/shared/api/socket/messages.ts"
  ],
  "rules": {
    // ── hooks + a11y (D2: oxlint native react / jsx-a11y sets, R-C1) ──────
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // ── oxlint 1.80 (#680) turned these on by default; MEASURED on main the day
    // of the bump: set-state-in-effect 111, refs 90,
    // immutability 17, globals 15, preserve-manual-memoization 13,
    // incompatible-library 3, purity 2, static-components 1,
    // no-irregular-whitespace 3 — 255 sites, and the
    // rule-layer self-test's HOOKS-DEPS green fixture among them. They are React
    // Compiler lints and a deprecation sweep, not the D2 contract this file
    // pins, so they are OFF here until adopted deliberately, one rule at a time,
    // with the sites fixed in the same change (tracked in the issue named in
    // the commit). Turning a rule on here without fixing its sites makes lint
    // red for every PR at once.
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "react/globals": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "off",
    "react/purity": "off",
    "react/static-components": "off",
    "eslint/no-irregular-whitespace": "off",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",

    // ── module hygiene ────────────────────────────────────────────────────
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",

    // ── complexity/size budgets with a native oxlint rule (D2) ────────────
    // File length + cyclomatic complexity are ALSO enforced by
    // scripts/check-budgets.mjs (§3.5); native rules give in-editor feedback.
    "complexity": ["error", 12],
    "max-lines": ["error", { "max": 400, "skipBlankLines": false, "skipComments": false }],

    // §3.6: empty catch is a lint error.
    "no-empty": ["error", { "allowEmptyCatch": false }],

    // ── transport + storage fences (R-A1/R-A4 + §5.4), native ─────────────
    "no-restricted-globals": [
      "error",
      { "name": "fetch", "message": "R-A1: fetch is called only inside shared/api/http.ts — use the typed client" },
      { "name": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts (upload progress)" },
      { "name": "localStorage", "message": "§5.4: storage goes through shared/lib/storage.ts under the el.* namespace" },
      { "name": "sessionStorage", "message": "§5.4: storage goes through shared/lib/storage.ts under the el.* namespace" }
    ],

    // The MEMBER-EXPRESSION half of R-A1/R-A4. `no-restricted-globals` matches
    // an unresolved identifier only, so it is blind to `window.fetch(...)`,
    // `globalThis.fetch(...)` and `self.fetch(...)`. That spelling shipped a
    // network client with no /api/v2 base, no credentials mode, no traceparent
    // and no 401 re-auth, and every gate stayed green — the same hole
    // `elitea/no-raw-webstorage` was written for on the storage side (issue
    // #22). The three objects are listed one by one on purpose: a bare
    // `{ "property": "fetch" }` catch-all also reports an unrelated `x.fetch`.
    "no-restricted-properties": [
      "error",
      { "object": "window", "property": "fetch", "message": "R-A1: fetch is called only inside shared/api/http.ts — use the typed client" },
      { "object": "globalThis", "property": "fetch", "message": "R-A1: fetch is called only inside shared/api/http.ts — use the typed client" },
      { "object": "self", "property": "fetch", "message": "R-A1: fetch is called only inside shared/api/http.ts — use the typed client" },
      { "object": "window", "property": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts (upload progress)" },
      { "object": "globalThis", "property": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts (upload progress)" },
      { "object": "self", "property": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts (upload progress)" }
    ],

    // ── import fences (R-A2/R-A3/R-T4/R-I1), native ───────────────────────
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "axios", "message": "R-A2: axios is banned — shared/api/http.ts covers every call" },
          { "name": "socket.io-client", "message": "R-A3: io() is created only inside shared/api/socket/client.ts" },
          { "name": "@emotion/react", "importNames": ["useTheme"], "message": "R-T4: useTheme comes from @mui/material/styles only (the @emotion/react one silently returns {} without a provider)" },
          { "name": "@mui/material", "importNames": ["useTheme"], "message": "R-T4: useTheme comes from @mui/material/styles only" },
          { "name": "@mui/system", "importNames": ["useTheme"], "message": "R-T4: useTheme comes from @mui/material/styles only" },
          { "name": "@mui/styles", "message": "R-T4: legacy @mui/styles is banned" },
          { "name": "@mui/icons-material", "message": "R-I1: no barrel import — import per icon: @mui/icons-material/Close" }
        ]
      }
    ],

    // ── local elitea/* fences (D2 remap of the no-restricted-syntax rows) ─
    "elitea/no-raw-color": "error",
    "elitea/no-mode-branch": "error",
    "elitea/no-important-sx": "error",
    "elitea/no-mui-internal-selector": "error",
    "elitea/no-theme-palette": "error",
    "elitea/raw-px-spacing": "error",
    "elitea/ad-hoc-radius": "error",
    "elitea/ad-hoc-font-size": "error",
    "elitea/no-export-all": "error",
    "elitea/no-module-scope-store": "error",
    "elitea/no-vi-mock": "error",
    "elitea/no-adhoc-envelope-unwrap": "error",
    "elitea/no-raw-webstorage": "error",

    // ── R-T3 via the eslint-plugin-i18next jsPlugins bridge (D2) ──────────
    "i18next/no-literal-string": [
      "error",
      {
        "mode": "jsx-only",
        "jsx-attributes": { "include": ["label", "title", "placeholder", "aria-label", "alt"] },
        "callees": { "exclude": ["t", "i18n", "console", "require", "register", "getFieldState", "watch", "handleSubmit", "renderCell"] }
      }
    ],

    // ── type-aware set, executed by tsgolint (D2 residual risk 2) ─────────
    // The ENTIRE 59-rule tsgolint surface is pinned explicitly: "error" rows
    // are the gate; every "off" row is deliberate and falls into one of
    // three classes:
    //   (a) stylistic preference, no defect class behind it (dot-notation,
    //       prefer-find/includes/optional-chain/nullish-coalescing,
    //       prefer-regexp-exec/string-starts-ends-with/return-this-type,
    //       non-nullable-type-assertion-style, no-unnecessary-qualifier/
    //       template-expression/type-arguments/type-conversion/
    //       type-parameters, no-useless-default-assignment,
    //       no-confusing-void-expression, promise-function-async,
    //       related-getter-setter-pairs, prefer-reduce-type-parameter);
    //   (b) already enforced by tsc flags in tsconfig.json (consistent-return
    //       ← noImplicitReturns; consistent-type-exports ←
    //       verbatimModuleSyntax);
    //   (c) rules whose fix pressure is DELETING defensive guards — the exact
    //       coverage-gaming §6.3 warns about (no-unnecessary-condition,
    //       strict-boolean-expressions, strict-void-return,
    //       no-unsafe-type-assertion, prefer-readonly,
    //       prefer-readonly-parameter-types).
    // tsgolint does NOT implement typescript-eslint's naming-convention or
    // prefer-destructuring; those two cannot be pinned here at all.
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-deprecated": "error",
    "typescript/consistent-return": "off",
    "typescript/consistent-type-exports": "off",
    "typescript/dot-notation": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/no-unnecessary-condition": "off",
    "typescript/no-unnecessary-qualifier": "off",
    "typescript/no-unnecessary-template-expression": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/prefer-find": "off",
    "typescript/prefer-includes": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/prefer-optional-chain": "off",
    "typescript/prefer-readonly": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/prefer-reduce-type-parameter": "off",
    "typescript/prefer-regexp-exec": "off",
    "typescript/prefer-return-this-type": "off",
    "typescript/prefer-string-starts-ends-with": "off",
    "typescript/promise-function-async": "off",
    "typescript/related-getter-setter-pairs": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/strict-void-return": "off"
  },
  "overrides": [
    {
      // R-A1 sanctioned path: the ONE place fetch is called.
      "files": ["src/shared/api/http.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts" },
          { "name": "localStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" },
          { "name": "sessionStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" }
        ]
      }
    },
    {
      // R-A4 sanctioned path: the ONE sanctioned XMLHttpRequest (upload progress).
      "files": ["src/shared/api/upload.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "fetch", "message": "R-A1: fetch is called only inside shared/api/http.ts" },
          { "name": "localStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" },
          { "name": "sessionStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" }
        ]
      }
    },
    {
      // R-A1 sanctioned path: the STANDALONE maintenance splash entry.
      //
      // `src/entries/maintenance` is built by `vite build --mode maintenance`
      // into ONE document (viteSingleFile) that an ingress serves in place of
      // the application. It has no AppProviders and no react-query by design,
      // and the typed client R-A1 points at brings the query cache, the
      // re-auth flow and the whole generated surface with it — into a page
      // whose job is to render one paragraph when the platform is down.
      //
      // The one request it makes is a GET of the PUBLIC settings document, so
      // an operator's splash copy can change without a redeploy. It sends no
      // credentials beyond the same-origin cookie, reads no error into the
      // page, and treats every failure as "nothing published".
      "files": ["src/entries/maintenance/lib/publishedCopy.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts" },
          { "name": "localStorage", "message": "§5.4: storage goes through shared/lib/storage.ts under the el.* namespace" },
          { "name": "sessionStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" }
        ]
      }
    },
    {
      // §5.4 sanctioned path: the storage wrapper itself.
      "files": ["src/shared/lib/storage.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "fetch", "message": "R-A1: fetch is called only inside shared/api/http.ts" },
          { "name": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts" }
        ]
      }
    },
    {
      // R-A1 sanctioned path (unit S6, spec §5.7 rows 1/3/5 + §2.4's http-core
      // row: "the two exceptions... are the sanctioned deviations"). These
      // three functions (S3 direct PUT, artifact blob/ZIP fetch, bucket/
      // artifact list) are structurally incompatible with createHttpClient:
      // they need a raw Blob body / response.blob() and, for the S3-proxy
      // routes, a base URL with /api/v2 explicitly STRIPPED (the opposite of
      // http.ts's contract) — http.ts's HttpResult<T> only ever parses
      // text/JSON and never exposes response headers or blob bodies, and it
      // cannot be edited here (F4 owns it). Spec errata: R-A1's table row
      // ("fetch may only be called inside shared/api/http.ts") and the S6
      // task's own framing only named 2 sanctioned deviations (this file's
      // S3 PUT, and upload.ts's XHR); this override is the fix for the gap
      // that left rows 3/5 unbuildable without it — flagged for folding back
      // into the spec/decision-record.
      "files": ["src/shared/api/artifacts.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts" },
          { "name": "localStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" },
          { "name": "sessionStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" }
        ]
      }
    },
    {
      // R-A1 sanctioned path (unit S6, spec §5.7 row 4). Same rationale as
      // the artifacts.ts override above: the markdown-export flow needs
      // response.blob() + the Content-Disposition header, which
      // createHttpClient cannot surface.
      "files": ["src/shared/lib/download.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "XMLHttpRequest", "message": "R-A4: XMLHttpRequest lives only in shared/api/upload.ts" },
          { "name": "localStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" },
          { "name": "sessionStorage", "message": "§5.4: storage goes through shared/lib/storage.ts" }
        ]
      }
    },
    {
      // R-A3 sanctioned path: the typed socket client wrapper.
      "files": ["src/shared/api/socket/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "axios", "message": "R-A2: axios is banned" },
              { "name": "@emotion/react", "importNames": ["useTheme"], "message": "R-T4: useTheme comes from @mui/material/styles only" },
              { "name": "@mui/material", "importNames": ["useTheme"], "message": "R-T4: useTheme comes from @mui/material/styles only" },
              { "name": "@mui/system", "importNames": ["useTheme"], "message": "R-T4: useTheme comes from @mui/material/styles only" },
              { "name": "@mui/styles", "message": "R-T4: legacy @mui/styles is banned" },
              { "name": "@mui/icons-material", "message": "R-I1: no barrel import" }
            ]
          }
        ]
      }
    },
    {
      // R-T1 scope: raw colour literals are legal ONLY in the token package.
      "files": ["src/shared/brand/tokens/**"],
      "rules": { "elitea/no-raw-color": "off" }
    },
    {
      // R-T7 scope: theme.palette.* is legal only inside shared/brand/.
      "files": ["src/shared/brand/**"],
      "rules": { "elitea/no-theme-palette": "off" }
    },
    {
      // R-T6 scope: internal MUI selectors are legal only in the override package.
      "files": ["src/shared/brand/mui-overrides/**"],
      "rules": { "elitea/no-mui-internal-selector": "off" }
    },
    {
      // R-M1 scope: vi.mock is legal only under __mocks__/.
      "files": ["src/**/__mocks__/**"],
      "rules": { "elitea/no-vi-mock": "off" }
    },
    {
      // STOR-1 sanctioned paths (issue #22): the storage wrapper itself, plus
      // the two jsdom web-storage shims that must install the real globals
      // before anything reads them.
      "files": [
        "src/shared/lib/storage.ts",
        "src/shared/lib/webstorage.testshim.ts",
        "src/test/webstorage.ts"
      ],
      "rules": { "elitea/no-raw-webstorage": "off" }
    },
    {
      // Docs SPA theme toggle (embedded-docs programme, PREAMBLE decision 1).
      // `elitea/no-raw-webstorage`'s reason is "so logout's clearNamespace()
      // actually clears it" (§5.4) — but this entry is a SEPARATE Vite mode
      // (`vite build --mode docs`, its own HTML/JS bundle at `/docs/`) with
      // no session, no login, and no logout: the main app's `clearNamespace()`
      // sweep never runs on this page and could not reach a key here even if
      // it did (different origin path, different bundle). Routing a docs
      // reader's theme preference through `shared/lib/storage.ts`'s `el.*`
      // namespace would misrepresent it as application session state it is
      // not. The stored key (`docs-theme`) is deliberately its own name, not
      // `el-mode`, for the same reason.
      "files": ["src/entries/docs/App.tsx"],
      "rules": { "elitea/no-raw-webstorage": "off" }
    },
    {
      // R-A6 sanctioned path (issue #132): the ONE place a response envelope
      // is unwrapped. Its own tests exercise the hand-rolled shapes it exists
      // to replace, so the fence is off for the pair.
      "files": ["src/shared/api/unwrap.ts", "src/shared/api/unwrap.test.ts"],
      "rules": { "elitea/no-adhoc-envelope-unwrap": "off" }
    },
    {
      // R-A6 scope: `items` here is a ControlsDropdown MENU row's children,
      // not an API list envelope — the rule matches on the key name alone and
      // cannot tell the two apart. Narrowed to the one component that models
      // submenus that way.
      "files": ["src/shared/ui/ControlsDropdown/**"],
