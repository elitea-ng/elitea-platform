# syntax=docker/dockerfile:1.7
# elitea-web image (spec §7.3). Lives WITH the app; every COPY path is
# repo-root-relative so the build context is identical ('.') in docker-bake.hcl,
# .github/workflows/publish.yml and Taskfile.yml — fixing defect D1 by
# construction. Local builds: podman build -f apps/elitea-web/Containerfile .

# ── Stage 1: build the SPA (three entries: app, admin, maintenance) ──────────
FROM node:26-trixie-slim AS builder

WORKDIR /build

# Lockfile-first for layer caching; npm ci needs the committed lockfile (D4).
COPY apps/elitea-web/package.json apps/elitea-web/package-lock.json ./
RUN npm ci

COPY apps/elitea-web/index.html apps/elitea-web/tsconfig.json apps/elitea-web/vite.config.ts ./
COPY apps/elitea-web/src/ ./src/
# Vite's default publicDir — copied verbatim into dist/app. Holds the brand
# assets the brand pack's `assets.*` paths point at (`/app/brand/*.svg`).
# Without this the SPA's history fallback answered those URLs with index.html
# under a 200, so a "does the pack's logo resolve?" check passed on HTML.
COPY apps/elitea-web/public/ ./public/
# `npm run build` (below) runs `build:docs`, which runs
# `node scripts/docs-build-search-index.mjs` before `vite build --mode docs`
# (embedded-docs programme decision 2/6) — the one build target that needs a
# script outside `src/`, so `scripts/` is copied only now, this late, rather
# than widening the lockfile-first layer above.
COPY apps/elitea-web/scripts/docs-build-search-index.mjs ./scripts/docs-build-search-index.mjs

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build

# ── Stage 2: serve the main SPA with nginx ────────────────────────────────────
#
# ONE OS FAMILY. Every image this repository builds sits on Debian 13 (trixie):
# the Go and Rust services on distroless debian13, the Python services on
# python:*-slim-trixie, and this one on nginx's trixie build. It was
# `nginx:stable-alpine` until 2026-10. The move costs about 37 MB compressed
# (26 MB to 64 MB for amd64) and gives one package database, one advisory feed
# and one set of tools across the fleet.
#
# THE TAG IS AN ALIAS ON PURPOSE, AND THE `ADD`s ARE NOT FILES THE IMAGE NEEDS.
#
# History, from the Alpine days: nginx:1.27-alpine carried 35 HIGH or CRITICAL
# findings when the scan in ci-image-scan.yml first ran (#433). Two fixes were
# then written here, and both failed quietly, for different reasons:
#
#   1. `1.29-alpine` is a MAINLINE BRANCH TAG, and nginx stops rebuilding one
#      once the next mainline opens. Five months after its last rebuild it still
#      shipped the packages of that day. A branch tag is a slow-motion freeze.
#      `stable-trixie` is the alias nginx keeps rebuilding (nginx 1.30.5 on
#      Debian 13.7 on 2026-10-06). It names the Debian release, so a new Debian
#      stable cannot move this image without an edit here; the nginx version
#      and the Debian point release move on their own. The daily scan in
#      ci-image-scan.yml is what watches an alias.
#
#   2. The package upgrade is a layer, and its command string never changes.
#      With `cache-from: type=gha` in both ci-image-scan.yml and publish.yml,
#      and a base digest that had stopped moving, BuildKit served it from cache
#      on every build (`#19 CACHED`). So the image held the upgrade of the day
#      that layer was FIRST built (22 HIGH findings on 2026-09-06), while the
#      same command run that day produced none of them. "Takes the fixes on the
#      day WE build" was true of the source and false of the build.
#
# The ADDs close (2). BuildKit re-resolves a remote source on every build and
# keys the layer on what it fetched, so the Debian release files invalidate the
# upgrade below when Debian publishes new packages for trixie, and never
# otherwise. They are STAMPS: apt never reads them. `trixie-security` carries
# the security fixes; `trixie-updates` carries the stable-updates fixes that
# arrive between point releases.
#
# The cost of the aliases is reproducibility: two builds of the same commit can
# hold different nginx and package versions. That is the trade, and the scan —
# on every pull request, every push to main, and daily — is what makes it
# visible and what proves the result.
FROM nginx:stable-trixie
ADD https://deb.debian.org/debian-security/dists/trixie-security/InRelease /usr/share/debian-stamps/trixie-security.InRelease
ADD https://deb.debian.org/debian/dists/trixie-updates/InRelease /usr/share/debian-stamps/trixie-updates.InRelease
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/dist/app /usr/share/nginx/html/spa
# Embedded docs SPA (embedded-docs programme decision 5): its own dist
# directory, served by spa.conf's separate `/docs/` location block — never
# merged into `spa/` above, so the two shells' `index.html`/`404.html`/
# `assets/` never collide.
COPY --from=builder /build/dist/docs /usr/share/nginx/html/docs
COPY apps/elitea-web/nginx/spa.conf /etc/nginx/conf.d/default.conf
# Included by every location block in spa.conf. nginx add_header does not merge
# across levels, so the set must be included, not inherited.
COPY apps/elitea-web/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
# Cross-Origin-Opener-Policy, kept apart because the two OAuth popup landing
# pages must not send it. That file records why.
COPY apps/elitea-web/nginx/opener-isolation.conf /etc/nginx/snippets/opener-isolation.conf
COPY apps/elitea-web/docker-entrypoint.sh /docker-entrypoint-config.sh
RUN chmod +x /docker-entrypoint-config.sh

EXPOSE 80
CMD ["/docker-entrypoint-config.sh"]
