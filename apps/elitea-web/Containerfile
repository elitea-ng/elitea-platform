# syntax=docker/dockerfile:1.7
# elitea-web image (spec §7.3). Lives WITH the app; every COPY path is
# repo-root-relative so the build context is identical ('.') in docker-bake.hcl,
# .github/workflows/publish.yml and Taskfile.yml — fixing defect D1 by
# construction. Local builds: podman build -f apps/elitea-web/Containerfile .

# ── Stage 1: build the SPA (three entries: app, admin, maintenance) ──────────
FROM node:24-alpine AS builder

WORKDIR /build

# Lockfile-first for layer caching; npm ci needs the committed lockfile (D4).
COPY apps/elitea-web/package.json apps/elitea-web/package-lock.json ./
RUN npm ci

COPY apps/elitea-web/index.html apps/elitea-web/tsconfig.json apps/elitea-web/vite.config.ts ./
COPY apps/elitea-web/src/ ./src/
# Vite's default publicDir — copied verbatim into dist/app. Holds the brand
# assets the brand pack's `assets.*` paths point at (`/app/brand/*.svg`).
# Without this the SPA's history fallback answered those URLs with index.html
# under a 200, so a "does the pack's logo resolve?" check passed on HTML.
COPY apps/elitea-web/public/ ./public/

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build

# ── Stage 2: serve the main SPA with nginx ────────────────────────────────────
#
# THE TAG IS AN ALIAS ON PURPOSE, AND THE `ADD` IS NOT A FILE THE IMAGE NEEDS.
#
# History: nginx:1.27-alpine sat on Alpine 3.21.3 and carried 35 HIGH or
# CRITICAL findings when the scan in ci-image-scan.yml first ran (#433) —
# openssl, libxml2, libexpat, libpng, musl, zlib. 1.29-alpine (Alpine 3.23.4)
# dropped that to 11, and `apk upgrade` was written here to clear the rest "on
# the day WE build".
#
# Both halves of that then failed, quietly, and for different reasons:
#
#   1. `1.29-alpine` is a MAINLINE BRANCH TAG, and nginx stops rebuilding one
#      once the next mainline opens. Its last rebuild was 2026-04-17; five
#      months on it still shipped Alpine 3.23.4 with curl 8.17.0-r1. A branch
#      tag is a slow-motion freeze, and it is how 1.27 rotted before it.
#      `stable-alpine` is the alias nginx keeps rebuilding — nginx 1.30.4 on
#      Alpine 3.24.1 today, with curl already at 8.22.0-r0. It is an alias
#      BECAUSE this repository has no dependabot docker ecosystem: a pinned
#      branch here is a bump nobody has scheduled, and the daily scan in
#      ci-image-scan.yml is what watches an alias.
#
#   2. `RUN apk upgrade --no-cache` is a layer, and its command string never
#      changes. With `cache-from: type=gha` in both ci-image-scan.yml and
#      publish.yml, and a base digest that had stopped moving, BuildKit served
#      it from cache on every build. The log said so in one word:
#      `#19 [stage-1 2/8] RUN apk upgrade --no-cache` / `#19 CACHED`. So the
#      image held the upgrade of whichever day that layer was FIRST built — on
#      2026-09-06 that was curl 8.20.0-r0 and libuuid 2.41.4-r0, 22 HIGH
#      findings — while the same command against the same base produced curl
#      8.22.0-r0 and libuuid 2.41.6-r1 the moment it actually ran. "Takes the
#      fixes on the day WE build" was true of the source and false of the build.
#
# The ADD closes (2). BuildKit re-resolves a remote source on every build and
# keys the layer on what it fetched, so the Alpine package index invalidates the
# upgrade below exactly when Alpine publishes new packages, and never otherwise.
# It is a STAMP: apk never reads it, and the `x86_64` in the path is not the
# build's architecture — the per-arch indexes are regenerated together, so any
# one of them dates the branch. `latest-stable` is an alias for the same reason
# the image tag is: a branch number written here would need editing every time
# the base moves to a new Alpine, and nothing would fail if nobody did it.
#
# The upgrade below is not a formality that the fresher base made redundant.
# `nginx:stable-alpine` on its own still reports 7 HIGH lines for libuuid
# 2.42.1-r0 (CVE-2026-53612/53613/53614/76642/78409/78410 fixed in 2.42.3-r0,
# CVE-2026-78408 in 2.42.3-r1); the upgrade is what takes them.
#
# The cost of both aliases is reproducibility: two builds of the same commit can
# hold different nginx and package versions. That is the trade, and the scan —
# on every pull request, every push to main, and daily — is what makes it
# visible and what proves the result.
FROM nginx:stable-alpine
ADD https://dl-cdn.alpinelinux.org/alpine/latest-stable/main/x86_64/APKINDEX.tar.gz /usr/share/alpine-apkindex-stamp.tar.gz
RUN apk upgrade --no-cache

COPY --from=builder /build/dist/app /usr/share/nginx/html/spa
COPY apps/elitea-web/nginx/spa.conf /etc/nginx/conf.d/default.conf
# Included by every location block in spa.conf. nginx add_header does not merge
# across levels, so the set must be included, not inherited.
COPY apps/elitea-web/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
# Cross-Origin-Opener-Policy, kept apart because the two OAuth popup landing
# pages must not send it. That file records why.
COPY apps/elitea-web/nginx/opener-isolation.conf /etc/nginx/snippets/opener-isolation.conf
COPY apps/elitea-web/docker-entrypoint.sh /docker-entrypoint-config.sh
RUN chmod +x /docker-entrypoint-config.sh

EXPOSE 80
CMD ["/docker-entrypoint-config.sh"]
