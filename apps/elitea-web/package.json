{
  "name": "elitea-web",
  "version": "0.1.0",
  "sideEffects": [
    "*.css"
  ],
  "private": true,
  "type": "module",
  "description": "Elitea web UI — drop-in replacement for apps/elitea-ui (spec: elitea-docs ui/spec-ui-reimplementation.md)",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:admin && npm run build:maintenance && npm run build:brand-preview",
    "build:app": "vite build",
    "build:admin": "vite build --mode admin",
    "build:maintenance": "vite build --mode maintenance",
    "build:brand-preview": "vite build --mode brand-preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json",
    "test:unit": "vitest run --config vitest.config.ts --project node",
    "test:storybook": "vitest run --config vitest.config.ts --project storybook",
    "theme-gate": "node scripts/theme-gate.mjs",
    "check-handlers": "node scripts/check-handlers.mjs",
    "check-fixture-freshness": "node scripts/check-fixture-freshness.mjs",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "e2e": "playwright test",
    "e2e:chat-stream": "bash scripts/chat-stream-e2e.sh",
    "e2e:visual": "node scripts/run-visual-container.mjs",
    "e2e:visual:update": "node scripts/run-visual-container.mjs --update-snapshots"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.11",
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.9.1",
    "@lezer/highlight": "1.2.3",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/system": "9.4.0",
    "@mui/x-data-grid": "9.12.0",
    "@mui/x-date-pickers": "9.12.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@uiw/react-codemirror": "4.25.11",
    "@xyflow/react": "12.11.6",
    "date-fns": "4.4.0",
    "dompurify": "3.4.14",
    "formik": "^2.4.9",
    "i18next": "26.4.1",
    "js-yaml": "5.4.1",
    "jszip": "3.10.1",
    "marked": "18.0.11",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.13",
    "recharts": "3.10.1",
    "simplebar-react": "3.3.2",
    "socket.io-client": "4.8.3",
    "yup": "^1.7.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "@swc/core": false,
    "esbuild": false,
    "fsevents": false,
    "msw": false
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.8",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@swc/core": "1.16.1",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "msw": "2.15.0",
    "orval": "8.27.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vite-plugin-svgr": "5.2.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  }
}
