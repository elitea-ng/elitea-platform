{
  // §4.6 check 1 ONLY: elitea/no-raw-color over src/, tokens package exempt.
  // Used by scripts/theme-gate.mjs with cwd = the gated root, so the override
  // glob is anchored with ** to hold for both the real src/ and fixture trees.
  // Native plugins and type-aware analysis are off — this config isolates one
  // check; the full lint config is .oxlintrc.json.
  // TEMPORARY (Wave 2 — remove when token refactoring lands):
  // F1's chat-messages unit predates the R-T1 fence and contains raw colour
  // literals; same exemption pattern as .oxlintrc.json's override.
  "plugins": [],
  "jsPlugins": ["../tools/lint-rules/index.mjs"],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "typeAware": false
  },
  "rules": {
    "elitea/no-raw-color": "error"
  },
  "overrides": [
    {
      // The desktop shell mixes theme.vars tokens with color-mix() (hover /
      // bezel tints): derived from tokens, never a literal colour.
      "files": ["**/widgets/desktop-shell/**", "**/entries/desktop/**", "**/pages/workspace/**", "**/features/workspace/**", "**/features/workspace-handoff/**", "**/features/workspace-index/**"],
      "rules": { "elitea/no-raw-color": "off" }
    },
    {
      "files": ["**/shared/brand/tokens/**"],
      "rules": { "elitea/no-raw-color": "off" }
    },
    {
      // Wave-2 C4: raw-colour literals predating R-T1 — same rationale as
      // the full .oxlintrc.json override (complexity, max-lines, i18n, etc.)
      "files": ["**/features/chat-messages/**"],
      "rules": { "elitea/no-raw-color": "off" }
    },
    {
      // Wave-2 C4: internal MUI selectors (.MuiChip-label, .MuiDialog-paper)
      // predating R-T6 — same rationale as .oxlintrc.json override.
      "files": ["**/features/chat-messages/**"],
      "rules": { "elitea/no-mui-internal-selector": "off" }
    },
    {
      // `support-assistant/vendor/**` is the PORTED SOURCE of
      // `@eliteaai/elitea-assistant`, brought in because the published package
      // streams over socket.io and this platform serves SSE.
      //
      // UNLIKE THE ENTRIES BELOW, THIS ONE IS NOT TEMPORARY and is not "code
      // that predates R-T1". The widget owns its colour system by design: it
      // computes a set of CSS custom properties from a light/dark theme and an
      // optional palette override (`vendor/theme/colors.theme.ts`), which is
      // what lets the same overlay sit on any host page. Rewriting it onto
      // `theme.vars.palette.*` would make the floating assistant a component of
      // this app's MUI theme — a redesign of the widget, not a token refactor.
      //
      // The same override, with the same reasoning, is in `.oxlintrc.json`.
      "files": ["**/widgets/support-assistant/vendor/**"],
      "rules": { "elitea/no-raw-color": "off" }
    },
    {
      // TEMPORARY (Wave 2 — remove when token refactoring lands):
      // These units predate the R-T1 fence and contain raw colour literals.
      "files": [
        "**/features/interactive-tours/**",
        "**/features/onboarding/**",
        "**/pages/onboarding/**",
        "**/pages/mode-switch/**",
        "**/entities/application/model/useCardLike.ts"
      ],
      "rules": { "elitea/no-raw-color": "off" }
    }
  ]
}
