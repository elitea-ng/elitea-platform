# The lockfile is COMMITTED (spec D4) — do not add package-lock.json here.
node_modules/
dist/
dist-desktop/
coverage/
coverage-shards/
coverage-scripts/
test-results/

# per-fixture-case configs generated (and normally cleaned) by
# scripts/check-gates-selftest.mjs — never commit a crash leftover
.oxlintrc.gen.json

# Playwright: auth storageState carries live session cookies; results are run artifacts.
.playwright-state/
playwright-results/
playwright-report/

# A build artefact: the legacy DeepWiki reducer, sliced out of apps/deepwiki-ui
# by scripts/deepwiki-oracle/extract-jsx-reducer.mjs. Regenerated on demand.
#
# Committing it would keep a second copy of code this repository is deleting —
# and it WAS committed once, by a `git add -A` that swept it in while it was
# untracked. CI then linted 245 lines of legacy code as though this repository
# had written them.
scripts/deepwiki-oracle/jsxReducer.generated.mjs
scripts/deepwiki-oracle/chatReducer.generated.mjs
