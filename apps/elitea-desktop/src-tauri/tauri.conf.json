{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sample",
  "version": "0.1.0",
  "identifier": "com.example.sample.desktop",
  "build": {
    "frontendDist": "../../elitea-web/dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../elitea-web run build:desktop",
    "beforeDevCommand": "npm --prefix ../elitea-web run dev -- --mode desktop --host localhost --port 5173"
  },
  "app": {
    "windows": [],
    "trayIcon": { "iconPath": "../../../brand/sample/assets/desktop/tray-template.png", "iconAsTemplate": true },
    "withGlobalTauri": false,
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data: https:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["../../../brand/sample/assets/desktop/32x32.png", "../../../brand/sample/assets/desktop/128x128.png", "../../../brand/sample/assets/desktop/128x128@2x.png", "../../../brand/sample/assets/macos/icon.icns", "../../../brand/sample/assets/windows/icon.ico"],
    "publisher": "Example Publisher",
    "copyright": "Copyright © Example Publisher",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  }
}
