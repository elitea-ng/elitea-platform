{
  // The browser driver's page scripts: driver.ts (macOS and Linux) and
  // input.ts (the Windows pane's input reporter). build.rs runs
  // `tsc -p js/tsconfig.json --outDir $OUT_DIR`, and src/lib.rs embeds the
  // emitted driver.js and input.js with include_str!; no JavaScript is
  // committed. Classic scripts, no imports or exports: each runs as a user
  // script in an isolated world.
  "compilerOptions": {
    // WebKit on macOS 12 and later runs ES2022.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // A script, not a module: no `export {}` is added, and the file's own
    // 'use strict' is the only prologue.
    "module": "preserve",
    "moduleDetection": "legacy",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": false,
    "sourceMap": false,
    "declaration": false,
    "newLine": "lf"
  },
  "files": ["driver.ts", "input.ts"]
}
