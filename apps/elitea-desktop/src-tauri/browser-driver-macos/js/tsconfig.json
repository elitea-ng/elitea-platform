{
  // The browser driver's page script (driver.ts). build.rs runs
  // `tsc -p js/tsconfig.json --outDir $OUT_DIR`, and src/lib.rs embeds the
  // emitted driver.js with include_str!; no JavaScript is committed. One
  // classic script, no imports or exports: WebKit runs it as a user script
  // in the driver's content world, and with evaluateJavaScript.
  "compilerOptions": {
    // WebKit on macOS 12 and later runs ES2022.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // A script, not a module: no `export {}` is added, and the file's own
    // 'use strict' is the only prologue.
    "module": "preserve",
    "moduleDetection": "legacy",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": false,
    "sourceMap": false,
    "declaration": false,
    "newLine": "lf"
  },
  "files": ["driver.ts"]
}
