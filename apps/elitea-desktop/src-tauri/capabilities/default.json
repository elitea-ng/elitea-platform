{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for the bundled UI window only. No remote origin is listed, so remote content gets no IPC at all.",
  "windows": ["main"],
  "permissions": [
    "allow-host-state",
    "allow-host-connect",
    "allow-host-sign-in",
    "allow-host-access-token",
    "allow-host-refresh",
    "allow-host-sign-out",
    "allow-host-wipe",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
