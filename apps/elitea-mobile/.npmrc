# Expo SDK 58 ships react-native 0.88.0-rc.3 (a prerelease). Several peer ranges
# in the SDK's own packages exclude it, and expo-modules-core 58.0.12 peers
# react-native-worklets <=0.10 while the SDK bundles 0.13.0. Under strict peer
# resolution npm nests expo-modules-core under expo/, where jest-expo and the
# expo-* modules cannot resolve it. Remove this once SDK 58 is stable and its
# peer ranges agree (check: rm .npmrc && rm -rf node_modules && npm install && npm test).
legacy-peer-deps=true
