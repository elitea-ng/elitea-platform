  "eliteaMark": {
    "name": "Elitea",
    "source": "libs/ts/client-core/src/brand/logo-mark.svg (LE-03, vector; src/components/EliteaMark.tsx)",
    "variants": {
      "mark": { "use": "connect hero, empty states, About, lock and privacy covers", "sizes": [64, 96, 112, 160] },
      "avatar": { "use": "the primary agent avatar fallback, on the theme surface", "sizes": [24, 28, 36, 48] }
    },
    "minSize": 24, "treatment": "never recoloured, tinted with the workspace brand or inverted"
  },
  "branding": {
    "overridable": ["accent", "accentPressed", "accentOn", "accentSoft", "accentSoftOn", "primary", "primaryPressed", "primaryOn", "bubbleUser", "bubbleUserText", "chipSelected", "chipSelectedText", "logoMark", "logoFull", "productName", "fontFamily (display/title roles)"],
    "fixed": ["focus", "background", "surface*", "elevated", "text*", "separator*", "secondary*", "ai", "aiText", "dot", "success*", "warning*", "danger*", "badge*", "bubbleAgent*", "chip", "chipText", "scrim", "skeleton", "spacing", "radius", "elevation", "typography scale", "motion", "haptics", "icons", "mascot"],
