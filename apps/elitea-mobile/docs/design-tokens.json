      "surface": "#1D1A22",
      "surfaceSunken": "#100E13",
      "surfaceGlass": { "rgb": "#2A2631", "alpha": 0.72, "blur": 24, "border": "rgba(255, 255, 255, 0.08)", "opaqueFallback": "#26222C" },
      "elevated": "#26222C",
      "textPrimary": "#F7F2F5",
