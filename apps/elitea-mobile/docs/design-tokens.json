{
  "$description": "Agent Zefir design tokens v1. Semantic colour sets for light and dark, the Agent Zefir primitives they are built from, and the non-colour scales. Read with design-system.md. Contrast ratios in `proofs` are WCAG 2.x, computed with the same formula as src/theme/color.ts (glass is proven composited over every gradient stop).",
  "version": "1.0.0",
  "primitives": {
    "marshmallow": { "50": "#FFF4F8", "100": "#FCE4EE", "200": "#F8C7DA", "300": "#F2A6C3", "400": "#E77AA4", "500": "#D04F86", "600": "#B4306A", "700": "#93244F", "800": "#6E1A3B", "900": "#3D1E2D" },
    "cream": { "50": "#FFFCFA", "100": "#FBF7F9", "200": "#F5EFF3" },
    "coat": { "50": "#EEF6FB", "100": "#DDEBF5", "200": "#BFDDF3", "300": "#A8CCE6", "400": "#8DC3EA", "500": "#5E9CC8", "600": "#2D6894", "700": "#1E4A6B", "800": "#1C2C3A" },
    "mint": { "50": "#EEF9F4", "100": "#E8F5EF", "200": "#CBE9DA", "300": "#9ED9D0", "500": "#3FA68A", "700": "#1D7A4C" },
    "belt": { "100": "#FCEBD6", "300": "#F0B98C", "400": "#E4A176", "600": "#B8652A", "700": "#8F5300" },
    "ink": { "0": "#FFFFFF", "50": "#F7F2F5", "100": "#E6DDE3", "300": "#BDB4C2", "400": "#9C93A2", "500": "#8E8592", "550": "#77707E", "600": "#6E6676", "700": "#5A5262", "900": "#1C1622" },
    "night": { "950": "#100E13", "900": "#141118", "850": "#1D1A22", "800": "#221F28", "750": "#26222C", "700": "#2A2631", "600": "#332E3A" }
  },
