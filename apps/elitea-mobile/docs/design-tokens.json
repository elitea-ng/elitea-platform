  "radius": { "xs": 6, "sm": 10, "md": 16, "lg": 22, "xl": 28, "sheet": 32, "pill": 9999,
    "usage": { "chip": "pill", "button": "pill", "card": "lg", "actionCard": "xl", "bubble": "lg", "bubbleTail": "xs", "composer": "xl", "listRow": "md", "sheetTop": "sheet", "avatar": "pill", "orb": "pill" },
    "note": "iOS: use continuous corners (borderCurve: 'continuous'). Android: plain radii; M3 shape scale medium=12, large=16, extra-large=28 are within one step of these." },
  "elevation": {
    "light": {
      "e0": { "shadowColor": "#0B0B18", "opacity": 0, "radius": 0, "offsetY": 0, "androidElevation": 0 },
      "e1": { "shadowColor": "#0B0B18", "opacity": 0.06, "radius": 12, "offsetY": 4, "androidElevation": 1, "use": "cards, chips on gradient" },
      "e2": { "shadowColor": "#0B0B18", "opacity": 0.10, "radius": 24, "offsetY": 8, "androidElevation": 3, "use": "floating composer, FAB, popovers" },
      "e3": { "shadowColor": "#0B0B18", "opacity": 0.16, "radius": 40, "offsetY": 16, "androidElevation": 6, "use": "sheets, menus" }
    },
    "dark": {
      "note": "Dark mode expresses elevation with lighter surfaces (surface -> elevated -> surfaceGlass) and a 1px top highlight border rgba(255,255,255,0.06); shadows are kept but nearly invisible.",
      "e1": { "shadowColor": "#000000", "opacity": 0.30, "radius": 12, "offsetY": 4, "androidElevation": 1 },
      "e2": { "shadowColor": "#000000", "opacity": 0.40, "radius": 24, "offsetY": 8, "androidElevation": 3 },
      "e3": { "shadowColor": "#000000", "opacity": 0.50, "radius": 40, "offsetY": 16, "androidElevation": 6 }
    }
  },
  "typography": {
    "family": { "ios": "System (SF Pro; SF Pro Rounded for display roles via fontFamily 'ui-rounded')", "android": "System (Roboto / Roboto Flex)", "mono": { "ios": "Menlo", "android": "monospace" }, "brand": "Workspace font (brand pack .ttf/.otf) may replace display + title roles only; never body/meta." },
    "roles": {
      "display":     { "ios": { "size": 34, "line": 41, "weight": "700", "textStyle": "largeTitle", "rounded": true },  "android": { "size": 36, "line": 44, "weight": "500", "m3": "displaySmall" },  "maxScale": 1.6 },
      "title1":      { "ios": { "size": 28, "line": 34, "weight": "700", "textStyle": "title1" },  "android": { "size": 28, "line": 36, "weight": "500", "m3": "headlineMedium" }, "maxScale": 1.8 },
      "title2":      { "ios": { "size": 22, "line": 28, "weight": "700", "textStyle": "title2" },  "android": { "size": 22, "line": 28, "weight": "500", "m3": "titleLarge" }, "maxScale": 2.0 },
      "title3":      { "ios": { "size": 20, "line": 25, "weight": "600", "textStyle": "title3" },  "android": { "size": 18, "line": 24, "weight": "500", "m3": "titleLarge (18 variant)" }, "maxScale": 2.0 },
      "headline":    { "ios": { "size": 17, "line": 22, "weight": "600", "textStyle": "headline" }, "android": { "size": 16, "line": 24, "weight": "500", "m3": "titleMedium" }, "maxScale": 2.2 },
      "body":        { "ios": { "size": 17, "line": 22, "weight": "400", "textStyle": "body" },    "android": { "size": 16, "line": 24, "weight": "400", "m3": "bodyLarge" }, "maxScale": 2.4 },
      "callout":     { "ios": { "size": 16, "line": 21, "weight": "400", "textStyle": "callout" }, "android": { "size": 14, "line": 20, "weight": "400", "m3": "bodyMedium" }, "maxScale": 2.4 },
      "subheadline": { "ios": { "size": 15, "line": 20, "weight": "400", "textStyle": "subheadline" }, "android": { "size": 14, "line": 20, "weight": "500", "m3": "labelLarge" }, "maxScale": 2.2 },
      "footnote":    { "ios": { "size": 13, "line": 18, "weight": "400", "textStyle": "footnote" }, "android": { "size": 12, "line": 16, "weight": "400", "m3": "bodySmall" }, "maxScale": 2.0 },
      "caption":     { "ios": { "size": 12, "line": 16, "weight": "400", "textStyle": "caption1" }, "android": { "size": 12, "line": 16, "weight": "500", "m3": "labelMedium" }, "maxScale": 1.8 },
      "label":       { "ios": { "size": 11, "line": 13, "weight": "600", "textStyle": "caption2" }, "android": { "size": 11, "line": 16, "weight": "500", "m3": "labelSmall" }, "maxScale": 1.5 },
      "code":        { "ios": { "size": 15, "line": 20, "weight": "400" }, "android": { "size": 14, "line": 20, "weight": "400" }, "maxScale": 2.0 }
    },
    "scaling": { "minScaleAllowed": "no lower bound (system decides)", "accessibilityLayoutSwitchAt": 1.35, "rule": "Never set allowFontScaling={false} on text that carries content. Clamp only chrome (tab labels, badges) with maxFontSizeMultiplier." }
  },
  "size": {
    "hitTarget": { "ios": 44, "android": 48 },
    "iconInline": 20, "iconButton": 22, "iconTab": 24,
    "circleButton": { "visual": 40, "compact": 36, "hitSlopTo": "hitTarget" },
    "avatar": { "xs": 24, "sm": 28, "md": 36, "lg": 48, "xl": 64 },
    "composerMinHeight": 52, "composerMaxLines": 6,
    "orb": { "compact": 160, "regular": 220, "max": 260 },
    "maxContentWidth": 640
  },
  "motion": {
    "duration": { "instant": 100, "fast": 180, "base": 260, "slow": 400, "orbBreath": 2400 },
    "easing": { "standard": [0.2, 0, 0, 1], "emphasizedDecelerate": [0.05, 0.7, 0.1, 1], "emphasizedAccelerate": [0.3, 0, 0.8, 0.15] },
    "spring": { "default": { "damping": 20, "stiffness": 220, "mass": 1 }, "bouncy": { "damping": 14, "stiffness": 180, "mass": 1 }, "snappy": { "damping": 26, "stiffness": 320, "mass": 1 } },
    "reducedMotion": "useReducedMotion() (Reanimated) or AccessibilityInfo.isReduceMotionEnabled: replace springs/translations/scales with 150 ms opacity cross-fades; orb breathing becomes a static level ring driven by audio level steps; streaming caret blink off; no parallax on the gradient."
  },
  "haptics": {
    "library": "expo-haptics",
    "events": {
      "send": "impact.light",
      "voiceStart": "impact.medium",
      "voiceStop": "impact.light",
      "copy": "notification.success",
      "feedbackLikeDislike": "selection",
      "swipeActionThreshold": "impact.rigid (iOS) / Android performAndroidHapticsAsync(Confirm) when available",
      "approvalApprove": "notification.success",
      "approvalReject": "notification.warning",
      "error": "notification.error",
      "tabOrChipChange": "selection"
    },
    "rule": "Haptics accompany a user-initiated action only, never streaming tokens or incoming notifications. Respect system setting (no in-app override needed; the OS mutes)."
  },
  "icons": {
    "ios": "expo-symbols SymbolView (SF Symbols), weight matches adjacent text, scale 'medium'",
    "android": "Material Symbols Rounded (weight 400, fill 0; fill 1 for selected tab) via expo-symbols' Android Material mapping or a bundled Material Symbols font",
    "map": {
      "home": ["house", "home"], "chats": ["bubble.left.and.bubble.right", "forum"], "discover": ["sparkles", "explore"], "settings": ["gearshape", "settings"],
