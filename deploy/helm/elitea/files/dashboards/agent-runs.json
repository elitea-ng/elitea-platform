    {
      "id": 20,
      "type": "table",
      "title": "Tool calls by agent and tool",
      "description": "Tool-call step records (ADR-0042) per agent and tool, top 50, from the database through the PostgreSQL data source. Prometheus has no per-agent series: an agent id is unbounded cardinality.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pgdatasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pgdatasource}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.project_id, s.application_id AS agent_id, s.toolkit_id, s.name AS tool, count(*) AS calls\nFROM elitea_runtime.run_steps s\nWHERE s.kind = 'tool_call' AND $__timeFilter(s.started_at)\nGROUP BY 1, 2, 3, 4\nORDER BY calls DESC\nLIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 12,
      "title": "Spend (integrity)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "table",
      "title": "Spend by agent",
      "description": "Billed LLM spend per agent, top 50: the gateway billing ledger (gateway.llm_usage_events) joined to the run's step-record head on the execution id. Only runs that produced step records are attributed; spend outside agent runs is not shown here.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pgdatasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pgdatasource}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT h.project_id, h.application_id AS agent_id,\n  sum(u.cost_usd) AS cost_usd, sum(u.total_tokens) AS tokens, count(DISTINCT h.run_id) AS runs\nFROM gateway.llm_usage_events u\nJOIN elitea_runtime.run_step_heads h ON h.run_id = u.execution_id\nWHERE $__timeFilter(u.occurred_at)\nGROUP BY h.project_id, h.application_id\nORDER BY cost_usd DESC\nLIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 14,
      "title": "Budget enforcement",
      "description": "1 when every gateway replica enforces budgets (min of gateway_budget_enforcement_enabled); 0 when any does not.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 55
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min(gateway_budget_enforcement_enabled{namespace=~\"$namespace\"})",
          "legendFormat": "Budget enforcement"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Unpriced or unbilled LLM usage",
      "description": "Usage that billed zero or a non-catalog figure: gateway_audio_unpriced_total, gateway_audio_default_priced_total, gateway_realtime_turns_unpriced_total, gateway_realtime_turns_unbilled_total (known spend dropped while draining) and gateway_realtime_turn_basis_mismatch_total. Billed realtime turns (gateway_realtime_turns_billed_total) are shown for scale. Platform-wide.",
      "datasource": {
