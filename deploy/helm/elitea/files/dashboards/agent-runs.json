            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(gateway_model_map_refused_no_project_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "model map: no project"
