          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (sink, kind) (rate(elitea_audit_export_failed_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{sink}} {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Audit events dead-lettered",
      "description": "Events given up on, by sink and source (elitea_audit_export_dead_lettered_total). source=\"run_step\" is run-step evidence. Any increase pages (EliteaAuditExportDeadLettered).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (sink, source) (increase(elitea_audit_export_dead_lettered_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{sink}} {{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "LLM requests the gateway refused",
      "description": "No Elitea service exports a per-agent (or per-application) label on any Prometheus series, and none is added for this dashboard: an agent id is unbounded cardinality. Requests the gateway refused before reaching a provider: the model map could not resolve the project model set (gateway_model_map_refused_*_total), an audio model with no catalog price under a budget (gateway_audio_refused_unpriced_model_total), and realtime refusals (gateway_realtime_refused_capacity_total, gateway_realtime_refused_unpriced_model_total, gateway_realtime_turns_refused_total). Provider errors and agent run failures are not exported as metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
