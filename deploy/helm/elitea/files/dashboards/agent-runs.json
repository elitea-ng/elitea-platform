          },
          "refId": "G",
          "expr": "sum(rate(gateway_realtime_turns_refused_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "realtime: turn refused by budget"
        }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Tool calls",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": []
