    {
      "type": "timeseries",
      "id": 7,
      "title": "Audit export delivery failures",
      "description": "Failed batch deliveries by sink and kind (elitea_audit_export_failed_total). transient is retried; permanent leads to dead-lettering after repeated refusals. Not per agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
