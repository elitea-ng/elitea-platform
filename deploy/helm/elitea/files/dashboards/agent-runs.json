{
  "uid": "elitea-agent-runs",
  "title": "Elitea / Agent runs, errors, tool calls and spend",
  "description": "Agent runs, errors, tool calls and spend from the metrics Elitea services actually export (elitea-main audit export, LLM gateway, scheduler). No Elitea service exports a per-agent (or per-application) label on any Prometheus series, and none is added for this dashboard: an agent id is unbounded cardinality. Every panel is platform-wide; per-agent figures come from the ADR-0042 run-step records and the usage ledger, not from Prometheus. There is no tool-call metric and no spend-amount metric: those rows say so instead of charting something else under that name. Per-agent panels read the step records and the billing ledger through a read-only PostgreSQL data source.",
  "tags": [
    "elitea",
    "agents",
    "adr-0042"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "options": [],
        "description": "Regex on the namespace label of the scraped series. .* also matches series scraped without one."
      },
      {
        "name": "pgdatasource",
        "label": "PostgreSQL (read-only)",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "description": "A read-only connection to the Elitea database, for the per-agent panels. Grant the Grafana role SELECT on elitea_runtime.run_step_heads, elitea_runtime.run_steps and gateway.llm_usage_events only."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Agent runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "table",
      "title": "Runs, tool calls and errors by agent",
      "description": "Per agent (application id) and project, top 50 by runs started in the time range, from the ADR-0042 step records through the PostgreSQL data source. Prometheus carries no per-agent label (unbounded cardinality), so this is the per-agent view.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pgdatasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pgdatasource}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT h.project_id, h.application_id AS agent_id,\n  count(DISTINCT h.run_id) AS runs,\n  count(s.run_id) FILTER (WHERE s.kind = 'model_call') AS model_calls,\n  count(s.run_id) FILTER (WHERE s.kind = 'tool_call') AS tool_calls,\n  count(s.run_id) FILTER (WHERE s.kind = 'retrieval') AS retrievals,\n  count(s.run_id) FILTER (WHERE s.kind = 'error') AS errors,\n  count(DISTINCT h.run_id) FILTER (WHERE s.kind = 'error') AS runs_with_errors\nFROM elitea_runtime.run_step_heads h\nLEFT JOIN elitea_runtime.run_steps s ON s.run_id = h.run_id\nWHERE $__timeFilter(h.created_at)\nGROUP BY h.project_id, h.application_id\nORDER BY runs DESC\nLIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Run-step records exported to the SIEM",
      "description": "No Elitea service exports a per-agent (or per-application) label on any Prometheus series, and none is added for this dashboard: an agent id is unbounded cardinality. This is the platform-wide rate of ADR-0042 run-step records the audit export delivered (elitea_audit_export_delivered_total, source=\"run_step\"), by sink. It counts steps, not runs, and only exists when the SIEM audit export is configured (ELITEA_AUDIT_EXPORT_OTLP_ENDPOINT or _WEBHOOK_URL). The series appears with the first delivered run step. For a per-agent breakdown, query the run-step records in the SIEM or the database, where the agent id is a field rather than a label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (sink) (rate(elitea_audit_export_delivered_total{source=\"run_step\",namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{sink}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Concurrent LLM streams (gateway)",
      "description": "Concurrent /llm SSE streams the LLM gateway is serving (gateway_llm_sse_active_connections, a gauge), summed over replicas. Every streaming agent turn holds one, so this is the closest live measure of agent load. Platform-wide: the gauge carries no agent, project or model label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(gateway_llm_sse_active_connections{namespace=~\"$namespace\"})",
          "legendFormat": "streams"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Audit export backlog by stream",
      "description": "Undelivered events per export stream (elitea_audit_export_backlog). The run-step stream is one stream beside security_audit and admin_audit; the EliteaAuditExportBacklog alert fires per stream.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (stream) (elitea_audit_export_backlog{namespace=~\"$namespace\"})",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Audit export lag by stream",
      "description": "Age of the oldest undelivered event per stream (elitea_audit_export_lag_seconds). The EliteaAuditExportLag alert fires per stream.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (stream) (elitea_audit_export_lag_seconds{namespace=~\"$namespace\"})",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 6,
      "title": "Errors",
      "collapsed": false,
