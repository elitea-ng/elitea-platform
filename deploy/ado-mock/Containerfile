# Deterministic fake Azure DevOps (wave 4, package W1).
#
# Same posture as deploy/qtest-mock and deploy/mock-llm: python:3.12-slim is
# already in this stack's build graph, the server is standard library only, so
# this pulls no new base image family and needs no network at build or run time.
FROM python:3.12.10-slim

# Non-root, and a uid that collides with nothing else in the stack (elitea-main
# is 65532, the worker 10001, redis 999, mock-llm 10101, qtest-mock 10102).
RUN useradd --system --uid 10103 --home-dir /nonexistent --shell /usr/sbin/nologin adomock

COPY server.py /opt/ado-mock/server.py

USER 10103:10103
EXPOSE 8097

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/opt/ado-mock/server.py"]
