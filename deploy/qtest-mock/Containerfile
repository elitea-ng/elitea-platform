# Deterministic fake qTest backend (issue #939, group 4).
#
# Same posture as deploy/mock-llm: python:3.12-slim is already in this stack's
# build graph, the server is standard library only, so this pulls no new base
# image family and needs no network at build or run time.
FROM python:3.12.10-slim

# Non-root, and a uid that collides with nothing else in the stack (elitea-main
# is 65532, the worker 10001, redis 999, mock-llm 10101).
RUN useradd --system --uid 10102 --home-dir /nonexistent --shell /usr/sbin/nologin qtestmock

COPY server.py /opt/qtest-mock/server.py

USER 10102:10102
EXPOSE 8096

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/opt/qtest-mock/server.py"]
