# syntax=docker/dockerfile:1.7

# ── Stage 1: build SPA ───────────────────────────────────────────────────────
FROM node:26-trixie-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/elitea-ui/package.json ./
RUN npm install
COPY apps/elitea-ui/ .
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build

# ── Stage 2: serve with nginx ─────────────────────────────────────────────────
# Debian 13 (trixie), like every image this repository builds. The alias tag,
# the release-file stamps and the package upgrade, all three for the reasons
# spelled out in the same block of apps/elitea-web/Containerfile: a branch tag
# (1.27-alpine, then 1.29-alpine) stops being rebuilt and freezes the base, and
# the upgrade layer is served from the GHA layer cache unless something above it
# moves. Both images carried the identical 22 HIGH findings on 2026-09-06
# because both made the same two assumptions. Keep the two blocks in step.
FROM nginx:stable-trixie
ADD https://deb.debian.org/debian-security/dists/trixie-security/InRelease /usr/share/debian-stamps/trixie-security.InRelease
ADD https://deb.debian.org/debian/dists/trixie-updates/InRelease /usr/share/debian-stamps/trixie-updates.InRelease
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/dist /usr/share/nginx/html/spa

RUN printf 'server {\n\
    listen 80;\n\
    \n\
    location = /app/config.js {\n\
        alias /usr/share/nginx/html/config.js;\n\
    }\n\
    location /app/assets/ {\n\
        alias /usr/share/nginx/html/spa/assets/;\n\
    }\n\
    location ~ ^/app/.+/assets/(.+)$ {\n\
        alias /usr/share/nginx/html/spa/assets/$1;\n\
    }\n\
    location ~ ^/app/.+/config\\.js$ {\n\
        alias /usr/share/nginx/html/config.js;\n\
    }\n\
    location /app/ {\n\
        alias /usr/share/nginx/html/spa/;\n\
        try_files $uri $uri/ /app/index.html;\n\
    }\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml;\n\
}\n' > /etc/nginx/conf.d/default.conf

# Inject config.js script tag into index.html (relative path)
RUN sed -i 's|<head>|<head><script src="./config.js"></script>|' /usr/share/nginx/html/spa/index.html

# Runtime config injection
RUN printf '#!/bin/sh\n\
cat > /usr/share/nginx/html/config.js <<EOF\n\
window.elitea_ui_config = {\n\
  vite_server_url: "${VITE_SERVER_URL:-}",\n\
  vite_base_uri: "${VITE_BASE_URI:-/app/}",\n\
  vite_socket_server: "${VITE_SOCKET_SERVER:-}",\n\
  vite_socket_path: "${VITE_SOCKET_PATH:-}",\n\
  vite_public_project_id: "${VITE_PUBLIC_PROJECT_ID:-}",\n\
  vite_dev_token: "${VITE_DEV_TOKEN:-}",\n\
  dev: "${DEV:-}"\n\
};\n\
EOF\n\
exec nginx -g "daemon off;"\n' > /docker-entrypoint-config.sh && chmod +x /docker-entrypoint-config.sh

EXPOSE 80
CMD ["/docker-entrypoint-config.sh"]
