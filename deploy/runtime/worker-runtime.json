{
  "schema_version": "elitea.runtime-deploy.v1",
  "limits_revision": "elitea.runtime.limits.conformance.v2",
  "workload_session_id": "standalone-agent-worker-1",
  "producer_id": "standalone-agent-worker-1",
  "consumer_id": "standalone-agent-worker-1-consumer",
  "redis_url": "rediss://worker@runtime-redis:6380/0",
  "redis_password_path": "/run/elitea-runtime/redis-worker-password",
  "redis_stream": "commands.v1.agent.execute.agent.shared.1.0",
  "redis_group": "elitea-agent-worker-v1",
  "control_target": "elitea-main:9443",
  "output_target": "elitea-main:9444",
  "content_origin": "https://elitea-main:9445",
  "platform_origin": "https://elitea-platform-edge",
  "ca_path": "/run/elitea-runtime/runtime-ca.crt",
  "certificate_path": "/run/elitea-runtime/agent-worker-client.crt",
  "private_key_path": "/run/elitea-runtime/agent-worker-client.key",
  "ed25519_keyring_path": "/run/elitea-runtime/command-signing-keyring.json",
  "spool_root": "/var/lib/elitea-worker/output-spool",
  "spool_key_path": "/run/elitea-runtime/worker-output-spool-key",
  "agent_checkpoint_connection_path": "/run/elitea-runtime/agent-checkpoint-connection",
  "limits": {
    "redis_read_batch": 4,
    "redis_block_millis": 1000,
    "redis_reclaim_idle_millis": 60000,
    "redis_reclaim_interval_millis": 5000,
    "dependency_retry_millis": 250,
    "delivery_max_concurrency": 32,
    "delivery_queue_capacity": 64,
    "sync_max_workers": 32,
    "sync_max_in_flight": 32,
    "admission_timeout_millis": 5000,
    "grpc_deadline_millis": 5000,
    "content_timeout_millis": 15000,
    "http_max_connections": 32,
    "http_max_keepalive_connections": 16,
    "output_max_queued_frames": 2,
    "output_max_queued_bytes": 131072,
    "output_max_sessions": 2,
    "output_ack_timeout_millis": 15000,
    "output_stream_deadline_millis": 300000,
    "lease_poll_interval_millis": 10000,
    "shutdown_timeout_millis": 30000
  }
}
