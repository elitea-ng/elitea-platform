# Test fixture only. Keep TLS verification enabled in all consumers.
# debian:trixie-slim is the base of python:3.12.14-slim-trixie below.
FROM docker.io/library/debian:trixie-slim AS tls
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /out \
 && openssl req -x509 -newkey rsa:2048 -nodes \
      -keyout /out/ca.key -out /out/ca.crt -days 3650 \
      -subj "/CN=elitea-oauth-emulator-ca" \
      -addext "basicConstraints=critical,CA:TRUE" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
 && openssl req -newkey rsa:2048 -nodes \
      -keyout /out/server.key -out /out/server.csr -subj "/CN=oauth-emulator" \
 && printf '%s\n' 'basicConstraints=critical,CA:FALSE' \
      'subjectAltName=DNS:oauth-emulator,DNS:localhost,IP:127.0.0.1' \
      'extendedKeyUsage=serverAuth' 'keyUsage=critical,digitalSignature,keyEncipherment' > /out/leaf.ext \
 && openssl x509 -req -in /out/server.csr -CA /out/ca.crt -CAkey /out/ca.key -CAcreateserial \
      -out /out/server.crt -days 3650 -sha256 -extfile /out/leaf.ext \
 && cat /out/server.crt /out/ca.crt > /out/server-chain.crt \
 && mkdir -p /pub \
 && cp /out/server-chain.crt /out/server.key /out/ca.crt /pub/

FROM docker.io/library/python:3.12.14-slim-trixie
RUN useradd --system --uid 10103 --home-dir /nonexistent --shell /usr/sbin/nologin oauthemulator
# ONE COPY for the whole key set: separate COPY lines are separate cache records
# that a shared cache can resolve from different mints of the `tls` stage (the
# served chain and the published ca.crt would then disagree).
COPY --from=tls /pub/ /opt/oauth-emulator/tls/
# Certs stay root-owned 0644; only the private key is handed to the server uid
# (0600), the same ownership model as mock-mcp.
RUN chown 10103:10103 /opt/oauth-emulator/tls/server.key \
 && chmod 0600 /opt/oauth-emulator/tls/server.key
COPY server.py /opt/oauth-emulator/server.py
USER 10103:10103
EXPOSE 8443
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python3", "/opt/oauth-emulator/server.py"]
