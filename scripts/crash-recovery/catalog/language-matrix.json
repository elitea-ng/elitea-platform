  "faults": {
    "BASE": {
      "cell": "baseline (no fault): {lang} Code, 50 s node",
      "now": "-",
      "baseline": true,
      "trigger": {"kind": "obs", "until": "admitted", "timeout_s": 30},
      "faults": [],
      "expect": {"budget_s": "{base_budget_s}"},
      "repeat": 1,
      "browser": false,
      "notes": "Control run. Its job count becomes the I2 oracle for this language's sleep fixture; run it first (a Rust run also compiles here, so later runs reuse the Ready snapshot)."
    },
    "WK": {
      "cell": "Worker (container restart) x P10, {lang} Code",
      "now": "not yet proven for {lang}",
      "trigger": {"kind": "obs", "until": "code_runtime_running", "timeout_s": "{trigger_timeout_s}",
                  "params": {"sleep_s": 50, "min_age_s": 3, "remaining_s": 30}},
      "faults": [{"action": "kill9", "target": "worker"},
                 {"action": "start", "target": "worker", "after_s": 2, "healthy": false}],
      "expect": {"takeovers": [1], "budget_s": "{fault_budget_s}"},
      "repeat": 3,
      "browser": true,
      "notes": "Same cut as CR-WK-P10 on the {lang} fixture."
    },
    "SK": {
      "cell": "Supervisor x P10 (process loss, runtime alive), {lang} Code",
      "now": "not yet proven for {lang}",
      "trigger": {"kind": "obs", "until": "code_runtime_running", "timeout_s": "{trigger_timeout_s}",
                  "params": {"sleep_s": 50, "min_age_s": 3, "remaining_s": 30}},
      "faults": [{"action": "kill9", "target": "supervisor"},
                 {"action": "start", "target": "supervisor", "after_s": 2, "healthy": false}],
      "expect": {"takeovers": [0], "budget_s": "{fault_budget_s}"},
      "repeat": 3,
      "browser": false,
      "notes": "Same cut as CR-SK-P10 on the {lang} fixture."
    },
    "MK": {
      "cell": "Main x P10, {lang} Code",
      "now": "not yet proven for {lang}",
      "trigger": {"kind": "obs", "until": "code_runtime_running", "timeout_s": "{trigger_timeout_s}",
                  "params": {"sleep_s": 50, "min_age_s": 3, "remaining_s": 30}},
      "faults": [{"action": "kill9", "target": "main"},
                 {"action": "start", "target": "main", "after_s": 2, "healthy": true}],
      "expect": {"takeovers": [0, 1], "budget_s": "{fault_budget_s}"},
      "repeat": 3,
      "browser": true,
      "notes": "Same cut as CR-MK-P10 on the {lang} fixture."
    },
    "STOP": {
      "cell": "user Stop while the {lang} Code runtime runs",
      "now": "not yet proven for {lang}",
      "trigger": {"kind": "obs", "until": "code_runtime_running", "timeout_s": "{trigger_timeout_s}",
                  "params": {"sleep_s": 50, "min_age_s": 3, "remaining_s": 30}},
      "faults": [{"action": "user_stop"}],
      "expect": {"takeovers": [0], "settlement": "CANCELLED", "budget_s": "{fault_budget_s}"},
      "repeat": 3,
      "browser": false,
      "notes": "A plain user Stop through the public API, no component loss: one CANCELLED settlement, the runtime removed."
    },
    "THROW": {
      "cell": "no fault: the {lang} Code throws",
      "now": "-",
      "target": "F",
      "fixture": "code-{lang}-throw",
      "trigger": {"kind": "obs", "until": "admitted", "timeout_s": 30},
      "faults": [],
      "expect": {"takeovers": [0], "settlement": "FAILED", "replay_codes": ["PIPELINE_CODE_FAILED"],
                 "no_reconcile_card": true, "budget_s": "{base_budget_s}"},
      "repeat": 1,
      "browser": false,
      "notes": "A thrown user error is a typed Code failure with a support reference and no operator reconcile card."
    },
    "NPM-BASE": {
      "cell": "baseline (no fault): {lang} node with an npm: import",
      "now": "-",
      "baseline": true,
