    "python": {"trigger_timeout_s": 150, "base_budget_s": 300, "fault_budget_s": 420},
    "javascript": {"trigger_timeout_s": 120, "base_budget_s": 240, "fault_budget_s": 360},
    "typescript": {"trigger_timeout_s": 120, "base_budget_s": 240, "fault_budget_s": 360},
    "rust": {"trigger_timeout_s": 360, "base_budget_s": 600, "fault_budget_s": 600}
  },
  "order": ["BASE", "WK", "SK", "MK", "STOP", "THROW"],
  "common": {
    "tier": "LM",
    "matrix_cell": null,
    "gap": null,
    "target": "R",
    "fixture": "code-{lang}-sleep-50",
    "pre_faults": [],
    "expect": {
      "takeovers": [0],
      "settlement": "SUCCEEDED",
      "error_codes": [],
