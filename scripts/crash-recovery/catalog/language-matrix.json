      "faults": [],
      "expect": {"budget_s": 480},
      "repeat": 1,
      "browser": false,
      "notes": "Control run: native preparation downloads slugify from the npm registry, then offline native execution. Sets the job and preparation-count oracle."
    },
    "NPM-WK": {
      "cell": "Worker (container restart) x P09, {lang} npm preparation",
      "now": "not yet proven for {lang}",
      "fixture": "code-{lang}-npm-50",
      "requires": {"feature": "npm", "reason": "JS/TS npm preparation needs the native Deno profile (stack feature `npm`)"},
      "trigger": {"kind": "obs", "until": "preparation_resolving", "timeout_s": 240, "params": {"min_age_s": 1}},
      "faults": [{"action": "kill9", "target": "worker"},
                 {"action": "start", "target": "worker", "after_s": 2, "healthy": false}],
      "expect": {"takeovers": [1], "budget_s": 600},
      "repeat": 3,
      "browser": false,
      "notes": "Kill the Worker while the native preparer resolves and downloads the npm package; same cut as CR-WK-P09."
    }
