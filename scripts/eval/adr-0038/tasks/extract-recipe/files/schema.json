{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "servings", "ingredients", "prep_minutes", "cook_minutes", "total_minutes", "oven_temp_c"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "servings": { "type": "integer", "minimum": 1 },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "quantity", "unit", "section", "optional"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "minimum": 0 },
          "unit": { "type": "string", "enum": ["g", "ml", "tsp", "tbsp", "cup", "piece"] },
          "section": { "type": "string", "enum": ["loaf", "topping"] },
          "optional": { "type": "boolean" }
        }
      }
    },
    "prep_minutes": { "type": "integer", "minimum": 0 },
    "cook_minutes": { "type": "integer", "minimum": 0 },
    "total_minutes": { "type": "integer", "minimum": 0 },
    "oven_temp_c": { "type": "integer" }
  }
}
