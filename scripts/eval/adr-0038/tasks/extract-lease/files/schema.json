{
  "type": "object",
  "additionalProperties": false,
  "required": ["landlord", "tenants", "property_address", "start_date", "end_date", "term_months", "currency", "monthly_rent", "security_deposit", "rent_due_day", "late_fee", "annual_increase_percent", "first_increase_date", "notice_period_days", "included_utilities", "parking_spaces", "pets_allowed"],
  "properties": {
    "landlord": { "type": "string", "minLength": 1 },
    "tenants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "property_address": { "type": "string", "minLength": 1 },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "term_months": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "monthly_rent": { "type": "number", "minimum": 0 },
    "security_deposit": { "type": ["number", "null"], "minimum": 0 },
    "rent_due_day": { "type": "integer", "minimum": 1, "maximum": 31 },
    "late_fee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "grace_days"],
      "properties": {
        "amount": { "type": ["number", "null"] },
        "grace_days": { "type": ["integer", "null"] }
      }
    },
    "annual_increase_percent": { "type": ["number", "null"] },
    "first_increase_date": { "type": ["string", "null"], "format": "date" },
    "notice_period_days": { "type": "integer", "minimum": 0 },
    "included_utilities": { "type": "array", "items": { "type": "string", "enum": ["water", "trash", "electricity", "gas", "heating", "internet"] } },
    "parking_spaces": { "type": "integer", "minimum": 0 },
    "pets_allowed": { "type": "boolean" }
  }
}
