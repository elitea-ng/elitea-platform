{
  "type": "object",
  "additionalProperties": false,
  "required": ["invoice_number", "vendor", "customer", "issue_date", "due_date", "currency", "line_items", "net_total", "vat_rate", "vat_amount", "total", "amount_due"],
  "properties": {
    "invoice_number": { "type": "string", "minLength": 1 },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vat_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "vat_id": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]+$" }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vat_id", "purchase_order"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "vat_id": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]+$" },
        "purchase_order": { "type": ["string", "null"] }
      }
    },
    "issue_date": { "type": "string", "format": "date" },
    "due_date": { "type": "string", "format": "date" },
    "currency": { "type": "string", "enum": ["EUR", "USD", "GBP", "CHF"] },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "description", "quantity", "unit_price", "amount"],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "minimum": 0 },
          "unit_price": { "type": "number", "minimum": 0 },
          "amount": { "type": "number" }
        }
      }
    },
    "net_total": { "type": "number" },
    "vat_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "vat_amount": { "type": "number" },
    "total": { "type": "number" },
    "amount_due": { "type": "number" }
  }
}
