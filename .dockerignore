# .dockerignore — shared by elitea-main (root context) and elitea-ui (root context) builds.
# elitea-main needs: services/elitea-main/**, apps/elitea-web/** (the admin SPA is
#                    built in-image from src/entries/admin), Go files.
# elitea-ui needs:   apps/elitea-ui/** source, deploy/docker/**.
# IMPORTANT: apps/elitea-web SOURCE must NOT be ignored — the image builds the
#            admin bundle from scratch.

# ── Version control ───────────────────────────────────────────────────────────
.git
**/.git

# ── Node dependencies (never needed in image; rebuilt inside) ─────────────────
**/node_modules

# ── Python caches and virtualenvs (never needed in image; rebuilt inside) ────
# .venv is what every Python service's README tells a developer to create, and
# it is multi-GB with an engine extra installed. Without this line it is COPYed
# into the build context: the elitea-inventory engine image failed at
# `COPY services/elitea-inventory` with "no space left on device", writing a
# 2.4 GB layer of the host's own virtualenv into the image it was building.
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# ── Rust build output ────────────────────────────────────────────────────────
**/target

# ── elitea-ui test/story artefacts (not needed at build time) ─────────────────
/apps/elitea-ui/tests
**/storybook-static

# ── Compiled Go binaries that may linger in the tree ─────────────────────────
/services/elitea-main/elitea-main
/services/elitea-main/cutover-ctl
/services/elitea-scheduler/elitea-scheduler
/services/elitea-llm-gateway/elitea-llm-gateway

# ── elitea-llm-gateway: rules its own .dockerignore used to carry ────────────
# That module built from its OWN directory as the context, so
# services/elitea-llm-gateway/.dockerignore governed it. The context is the
# repository root now (the module replaces libs/go/egresslib with
# ../../libs/go/egresslib), and a build reads the .dockerignore beside the
# CONTEXT ROOT only — the module's file is no longer consulted at all. Its
# rules move here rather than lapsing silently.
#
# `.env` is the one that matters: a developer's local file would otherwise
# enter the build context and land in a builder layer, and builder layers go
# to the `type=gha` cache.
/services/elitea-llm-gateway/.env
/services/elitea-llm-gateway/.env.*
/services/elitea-llm-gateway/vendor

# ── Go test / coverage output ─────────────────────────────────────────────────
coverage.out
**/*.test

# ── Deploy runtime data (not source) ─────────────────────────────────────────
/deploy/data

# ── Tooling / IDE / OS artefacts ─────────────────────────────────────────────
.DS_Store
**/.DS_Store
.claude
**/*.log
**/.env.local
**/.env.*.local
