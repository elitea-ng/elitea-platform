{
  "schema_version": "elitea.llm-caller-contract.v1",
  "description": "What every Rust caller of the platform /llm edge (the agent worker, the engine model client) must send and how it must read the answer. One fixture, asserted by both: services/elitea-worker-rust (transport/openai_compatible_facade_tests.rs) and libs/rust/model-client (tests/caller_contract.rs). The prose is libs/rust/model-client/docs/llm-caller-contract.md.",
  "request": {
    "route": "/llm/v1/chat/completions",
    "headers": {
      "authorization": "Bearer {token}",
      "x-project-id": "{project_id}",
      "x-elitea-execution-id": "{execution_id}"
    },
    "headers_absent": ["openai-organization", "openai-project"],
    "execution_id": {
      "max_bytes": 128,
      "alphabet": "A-Za-z0-9-_.",
      "valid": ["0123456789abcdef0123456789abcdef", "callback-6f1c2d4e-8a7b-4c3d-9e2f-1a2b3c4d5e6f"],
      "invalid": ["", "a:b", "execution id", "a/b"]
    }
  },
  "refusals": [
    {"name": "member budget", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "member_budget_exceeded", "scope": "member", "message": "member budget exhausted for this billing period"}}, "code": "model_gateway.member_budget_exhausted", "retryable": false},
    {"name": "member budget, older gateway without scope", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "member_budget_exceeded", "message": "member budget exhausted for this billing period"}}, "code": "model_gateway.member_budget_exhausted", "retryable": false},
    {"name": "project budget", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "insufficient_quota", "scope": "project", "message": "project budget exhausted for this billing period"}}, "code": "model_gateway.project_budget_exhausted", "retryable": false},
    {"name": "provider quota, unscoped", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "insufficient_quota", "message": "provider quota"}}, "code": "model_gateway.budget_exhausted", "retryable": false},
    {"name": "unknown scope is unscoped", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "insufficient_quota", "scope": "provider", "message": "provider quota"}}, "code": "model_gateway.budget_exhausted", "retryable": false},
    {"name": "not a budget_exceeded type", "status": 402, "body": {"error": {"type": "insufficient_quota", "message": "provider quota"}}, "code": "model_gateway.budget_exhausted", "retryable": false},
    {"name": "credential refused", "status": 401, "body": {"error": {"type": "authentication_error", "message": "no"}}, "code": "model_gateway.unauthorized", "retryable": false},
    {"name": "project refused", "status": 403, "body": {"error": {"type": "permission_error", "code": "project_inactive", "message": "no"}}, "code": "model_gateway.forbidden", "retryable": false},
    {"name": "request timeout", "status": 408, "body": {}, "code": "model_gateway.upstream_timeout", "retryable": true},
    {"name": "gateway timeout", "status": 504, "body": {}, "code": "model_gateway.upstream_timeout", "retryable": true},
    {"name": "rate limited", "status": 429, "body": {"error": {"type": "rate_limit_error", "message": "slow down"}}, "code": "model_gateway.rate_limited", "retryable": true},
    {"name": "conflict", "status": 409, "body": {}, "code": "model_gateway.conflict", "retryable": true},
    {"name": "internal error", "status": 500, "body": {}, "code": "model_gateway.unavailable", "retryable": true},
    {"name": "bad gateway", "status": 502, "body": {}, "code": "model_gateway.unavailable", "retryable": true},
    {"name": "unavailable", "status": 503, "body": {}, "code": "model_gateway.unavailable", "retryable": true},
    {"name": "bad request", "status": 400, "body": {"error": {"type": "invalid_request_error", "code": "project_scope_conflict", "message": "no"}}, "code": "model_gateway.rejected", "retryable": false},
    {"name": "unknown model", "status": 404, "body": {"error": {"type": "invalid_request_error", "message": "no such model"}}, "code": "model_gateway.rejected", "retryable": false},
    {"name": "unprocessable", "status": 422, "body": {}, "code": "model_gateway.rejected", "retryable": false}
  ],
  "reasoning": {
    "request_field": "reasoning_effort",
    "efforts": ["none", "low", "medium", "high"],
    "message_fields": ["reasoning_content", "reasoning"],
    "usage": {
      "reasoning_tokens": "completion_tokens_details.reasoning_tokens",
      "cached_tokens": "prompt_tokens_details.cached_tokens"
    },
    "stream": [
      {"choices": [{"index": 0, "delta": {"role": "assistant", "reasoning_content": "Think "}}]},
      {"choices": [{"index": 0, "delta": {"reasoning_content": "first."}}]},
      {"choices": [{"index": 0, "delta": {"content": "The answer."}}]},
      {"choices": [{"index": 0, "delta": {}, "finish_reason": "stop"}]},
      {"choices": [], "usage": {"prompt_tokens": 10, "completion_tokens": 9, "total_tokens": 19, "completion_tokens_details": {"reasoning_tokens": 6}, "prompt_tokens_details": {"cached_tokens": 4}}}
    ],
    "expected": {"content": "The answer.", "reasoning": "Think first.", "reasoning_tokens": 6, "cached_tokens": 4}
  },
  "thinking": {
    "description": "ADR-0038 decision 2: the OpenAI-compatible request form of one step's thinking per catalogue control kind. A null body member means the member is absent. Both Rust callers build their bodies with elitea-llm-wire thinking::openai_form.",
    "settings": {
      "auto": "auto",
      "off": "off",
      "none": "off",
      "low": "low",
      "medium": "medium",
      "high": "high"
    },
    "refused_settings": [
      "max",
      "minimal",
      "OFF",
      ""
    ],
    "openai_compatible": [
      {
        "control": "effort",
        "step": "off",
        "reasoning_effort": "none",
        "enable_thinking": null
      },
      {
        "control": "effort",
        "step": "high",
        "reasoning_effort": "high",
        "enable_thinking": null
      },
      {
        "control": "budget",
        "step": "off",
        "reasoning_effort": "none",
        "enable_thinking": null
      },
      {
        "control": "budget",
        "step": "low",
        "reasoning_effort": "low",
        "enable_thinking": null
      },
      {
        "control": "toggle",
        "step": "off",
        "reasoning_effort": null,
        "enable_thinking": false
      },
      {
        "control": "toggle",
        "step": "medium",
        "reasoning_effort": null,
        "enable_thinking": true
      },
      {
        "control": "fixed_on",
        "step": "high",
        "reasoning_effort": null,
        "enable_thinking": null
      },
      {
        "control": "fixed_off",
        "step": "off",
        "reasoning_effort": null,
        "enable_thinking": null
      }
    ],
    "conflicts": [
      {
        "control": "fixed_on",
        "setting": "off"
      },
      {
        "control": "fixed_off",
        "setting": "low"
      },
      {
        "control": "fixed_off",
        "setting": "medium"
      },
      {
        "control": "fixed_off",
        "setting": "high"
      }
    ],
    "auto_policy": {
      "description": "ADR-0038 decision 4: the thinking of one request (elitea-llm-wire thinking::step), the one copy of the auto policy. control null: the catalogue declares none. setting null: nothing configured. expect: off, a level, or null (nothing sent).",
      "cases": [
        {"note": "no setting sends nothing", "setting": null, "control": "toggle", "tool_steps": false, "off_with_tools": false, "kind": "planning", "has_tools": false, "expect": null},
        {"note": "undeclared: auto thinks at the default level on every step", "setting": "auto", "control": null, "tool_steps": false, "off_with_tools": false, "kind": "tool_follow_up", "has_tools": false, "expect": "medium"},
        {"note": "undeclared: an explicit setting", "setting": "off", "control": null, "tool_steps": false, "off_with_tools": false, "kind": "planning", "has_tools": false, "expect": "off"},
        {"note": "an explicit level wins on every step", "setting": "high", "control": "toggle", "tool_steps": false, "off_with_tools": false, "kind": "tool_follow_up", "has_tools": false, "expect": "high"},
        {"note": "auto plans", "setting": "auto", "control": "toggle", "tool_steps": false, "off_with_tools": false, "kind": "planning", "has_tools": false, "expect": "medium"},
        {"note": "auto recovers", "setting": "auto", "control": "effort", "tool_steps": false, "off_with_tools": false, "kind": "recovery", "has_tools": false, "expect": "medium"},
        {"note": "auto answers a schema", "setting": "auto", "control": "effort", "tool_steps": false, "off_with_tools": false, "kind": "structured_answer", "has_tools": false, "expect": "medium"},
        {"note": "auto skips a routine tool step", "setting": "auto", "control": "toggle", "tool_steps": false, "off_with_tools": false, "kind": "tool_follow_up", "has_tools": false, "expect": "off"},
        {"note": "tool_steps keeps a tool step on", "setting": "auto", "control": "effort", "tool_steps": true, "off_with_tools": false, "kind": "tool_follow_up", "has_tools": false, "expect": "medium"},
        {"note": "auxiliary calls do not think", "setting": "auto", "control": "effort", "tool_steps": true, "off_with_tools": false, "kind": "auxiliary", "has_tools": false, "expect": "off"},
        {"note": "budget: one state through the tool loop", "setting": "auto", "control": "budget", "tool_steps": false, "off_with_tools": false, "kind": "tool_follow_up", "has_tools": false, "expect": "medium"},
        {"note": "budget: a recovery step keeps it", "setting": "auto", "control": "budget", "tool_steps": false, "off_with_tools": false, "kind": "recovery", "has_tools": false, "expect": "medium"},
        {"note": "budget: auxiliary calls do not think", "setting": "auto", "control": "budget", "tool_steps": false, "off_with_tools": false, "kind": "auxiliary", "has_tools": false, "expect": "off"},
        {"note": "off_with_tools: the planning step of a tool request", "setting": "auto", "control": "effort", "tool_steps": false, "off_with_tools": true, "kind": "planning", "has_tools": true, "expect": "off"},
        {"note": "off_with_tools: a step without tools still thinks", "setting": "auto", "control": "effort", "tool_steps": false, "off_with_tools": true, "kind": "planning", "has_tools": false, "expect": "medium"},
        {"note": "off_with_tools: no setting still sends off beside tools", "setting": null, "control": "effort", "tool_steps": false, "off_with_tools": true, "kind": "planning", "has_tools": true, "expect": "off"},
        {"note": "off_with_tools: an explicit level is the caller's", "setting": "high", "control": "effort", "tool_steps": false, "off_with_tools": true, "kind": "planning", "has_tools": true, "expect": "high"}
      ]
    },
    "classify": {
      "description": "The kind of an agent-loop request from the tool results of its last conversation turn (elitea-llm-wire thinking::classify).",
      "cases": [
        {"structured": false, "results": [], "kind": "planning"},
        {"structured": false, "results": [{"text": "ok"}], "kind": "tool_follow_up"},
        {"structured": false, "results": [{"text": "ok"}, {"error": "denied"}], "kind": "recovery"},
        {"structured": false, "results": [{"status": "error"}], "kind": "recovery"},
        {"structured": false, "results": [{"error": null, "text": "ok"}], "kind": "tool_follow_up"},
        {"note": "a command that exits 0 succeeded", "structured": false, "results": [{"exit_code": 0, "stdout": "ok"}], "kind": "tool_follow_up"},
        {"note": "a command that exits 1 failed", "structured": false, "results": [{"exit_code": 1, "stderr": "boom"}], "kind": "recovery"},
        {"note": "exitCode, a negative code (killed or timed out)", "structured": false, "results": [{"exitCode": -1}], "kind": "recovery"},
        {"note": "a string is not an exit code", "structured": false, "results": [{"exit_code": "1"}], "kind": "tool_follow_up"},
        {"note": "a null exit code (killed by a signal) is not a failure by itself", "structured": false, "results": [{"exit_code": null, "timed_out": false}], "kind": "tool_follow_up"},
        {"note": "a wrapped result is read one level down", "structured": false, "results": [{"result": {"exit_code": 2}}], "kind": "recovery"},
        {"structured": true, "results": [{"text": "ok"}], "kind": "structured_answer"}
      ]
    },
    "continuation": {
      "description": "The setting an output continuation runs at (elitea-llm-wire thinking::continuation_setting). control null: undeclared.",
      "cases": [
        {"setting": "auto", "control": "toggle", "expect": "off"},
        {"setting": "auto", "control": "budget", "expect": "auto"},
        {"setting": "auto", "control": "effort", "expect": "low"},
        {"setting": "auto", "control": null, "expect": "low"},
        {"setting": "high", "control": "toggle", "expect": "low"},
        {"setting": "off", "control": "effort", "expect": "off"}
      ]
    }
  }
}
