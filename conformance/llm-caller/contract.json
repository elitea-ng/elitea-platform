    {"name": "member budget, older gateway without scope", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "member_budget_exceeded", "message": "member budget exhausted for this billing period"}}, "code": "model_gateway.member_budget_exhausted", "retryable": false},
    {"name": "project budget", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "insufficient_quota", "scope": "project", "message": "project budget exhausted for this billing period"}}, "code": "model_gateway.project_budget_exhausted", "retryable": false},
    {"name": "provider quota, unscoped", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "insufficient_quota", "message": "provider quota"}}, "code": "model_gateway.budget_exhausted", "retryable": false},
    {"name": "unknown scope is unscoped", "status": 402, "body": {"error": {"type": "budget_exceeded", "code": "insufficient_quota", "scope": "provider", "message": "provider quota"}}, "code": "model_gateway.budget_exhausted", "retryable": false},
    {"name": "not a budget_exceeded type", "status": 402, "body": {"error": {"type": "insufficient_quota", "message": "provider quota"}}, "code": "model_gateway.budget_exhausted", "retryable": false},
    {"name": "credential refused", "status": 401, "body": {"error": {"type": "authentication_error", "message": "no"}}, "code": "model_gateway.unauthorized", "retryable": false},
    {"name": "project refused", "status": 403, "body": {"error": {"type": "permission_error", "code": "project_inactive", "message": "no"}}, "code": "model_gateway.forbidden", "retryable": false},
    {"name": "request timeout", "status": 408, "body": {}, "code": "model_gateway.upstream_timeout", "retryable": true},
    {"name": "gateway timeout", "status": 504, "body": {}, "code": "model_gateway.upstream_timeout", "retryable": true},
    {"name": "rate limited", "status": 429, "body": {"error": {"type": "rate_limit_error", "message": "slow down"}}, "code": "model_gateway.rate_limited", "retryable": true},
    {"name": "conflict", "status": 409, "body": {}, "code": "model_gateway.conflict", "retryable": true},
    {"name": "internal error", "status": 500, "body": {}, "code": "model_gateway.unavailable", "retryable": true},
    {"name": "bad gateway", "status": 502, "body": {}, "code": "model_gateway.unavailable", "retryable": true},
    {"name": "unavailable", "status": 503, "body": {}, "code": "model_gateway.unavailable", "retryable": true},
    {"name": "bad request", "status": 400, "body": {"error": {"type": "invalid_request_error", "code": "project_scope_conflict", "message": "no"}}, "code": "model_gateway.rejected", "retryable": false},
