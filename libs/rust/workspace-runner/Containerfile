# syntax=docker/dockerfile:1.7
#
# The cloud executor's workspace sandbox image (ADR-0034 decision 9).
#
# One container per cloud turn runs `elitea-workspace-runner` over a
# disk-backed, exec-mounted /workspace. The image ships git (the runner's git
# tools and the baseline commit) and a general build toolchain, because the
# agent's `run_command` builds and tests the user's project. It carries no
# credential, no Elitea token and no store client: the worker moves the files
# in and out through the sandbox helper protocol.
#
# Debian 13 (trixie), the release every image in this repository uses.
# Build from the repository root:
#
#   podman build -f libs/rust/workspace-runner/Containerfile -t elitea-workspace-runner:dev .

FROM rust:1.97.1-trixie@sha256:b1b3c9c0d921d7fa0a6d1f9ec7e4eab87f8c8ec97644c3d791450f131dec813f AS builder
# A transient GitHub/crates.io failure must not fail the build: cargo's
# built-in libgit2 fetch gave up on one TLS error ("SSL error: unknown error",
# then "revision ... not found") for a pinned tree-sitter git dependency in
# CI. The git CLI and more retries ride over it; the lockfile still pins
# every revision and checksum.
ENV CARGO_NET_RETRY=10 \
    CARGO_NET_GIT_FETCH_WITH_CLI=true
WORKDIR /src
COPY libs/rust/ libs/rust/
# The runner links the agent runtime, whose platform-rpc build.rs compiles
# the elitea.runtime.v1 contracts at ../../proto (#1359).
COPY libs/proto/elitea/ libs/proto/elitea/
# /src/libs/rust/target is shared with every other build on the host, and
# cargo judges a path crate fresh by mtime, so a context older than another
# checkout's build would ship that build's binary. Touching /src under the
# lock recompiles the runner from this context while registry crates stay
# cached (see the worker's Containerfile).
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/libs/rust/target,sharing=locked \
    find /src -type f -exec touch {} + && \
    cd libs/rust && \
    cargo build --release --locked -p elitea-workspace-runner && \
    install -D -m 0755 target/release/elitea-workspace-runner /out/elitea-workspace-runner

FROM debian:trixie-slim AS runtime
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        bash build-essential ca-certificates coreutils curl findutils git \
        grep less procps python3 python3-venv sed tar unzip xz-utils && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/elitea-workspace-runner /usr/local/bin/elitea-workspace-runner
# The workspace volume is mounted here; the sandbox owner (uid 10001) owns it.
RUN groupadd --gid 10001 elitea && \
    useradd --uid 10001 --gid 10001 --home-dir /home/elitea --create-home --shell /bin/bash elitea && \
    install -d -o 10001 -g 10001 -m 0700 /workspace
USER 10001:10001
WORKDIR /workspace
ENV HOME=/home/elitea \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_TERMINAL_PROMPT=0
ENTRYPOINT ["/usr/local/bin/elitea-workspace-runner"]
CMD ["serve"]
