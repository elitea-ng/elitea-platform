{
  "version": 1,
  "about": "Credential-shaped content that blocks a handoff (ADR-0034 decision 5). A gitleaks-style subset, written for this repository; shipped as data and read at build time. `secret_group` is the capture group holding the secret (0: the whole match); a match whose secret matches any `allow` pattern is not a finding.",
  "rules": [
    {
      "id": "aws-access-key-id",
      "description": "AWS access key id",
      "regex": "\\b((?:AKIA|ASIA|ABIA|ACCA|A3T[A-Z0-9])[A-Z2-7]{16})\\b",
      "secret_group": 1,
      "allow": ["EXAMPLE$"]
    },
    {
      "id": "aws-secret-access-key",
      "description": "AWS secret access key",
      "regex": "(?i)aws_?secret_?access_?key[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9/+=]{40})\\b",
      "secret_group": 1,
      "allow": ["EXAMPLEKEY$"]
    },
    {
      "id": "private-key",
      "description": "private key",
      "regex": "-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----",
      "secret_group": 0,
      "allow": []
    },
    {
      "id": "github-token",
      "description": "GitHub token",
      "regex": "\\b((?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36})\\b",
      "secret_group": 1,
      "allow": []
    },
    {
      "id": "github-fine-grained-token",
      "description": "GitHub fine-grained token",
      "regex": "\\b(github_pat_[A-Za-z0-9_]{82})\\b",
      "secret_group": 1,
      "allow": []
    },
    {
      "id": "gitlab-token",
      "description": "GitLab token",
      "regex": "\\b(gl(?:pat|dt|ptt|rt)-[A-Za-z0-9_-]{20,})\\b",
      "secret_group": 1,
      "allow": []
    },
    {
      "id": "slack-token",
      "description": "Slack token",
      "regex": "\\b(xox[abposr]-[A-Za-z0-9-]{10,})\\b",
      "secret_group": 1,
      "allow": []
    },
    {
      "id": "slack-webhook",
      "description": "Slack webhook URL",
      "regex": "(https://hooks\\.slack\\.com/(?:services|workflows)/[A-Za-z0-9+/]{20,})",
      "secret_group": 1,
      "allow": []
    },
    {
      "id": "connection-string-password",
      "description": "URL or connection string with a password",
      "regex": "\\b[a-zA-Z][a-zA-Z0-9+.-]{1,30}://[^\\s:/@\"']{1,100}:([^\\s@/\"']{3,200})@[^\\s/\"']+",
      "secret_group": 1,
      "allow": ["^\\$", "^\\{", "^<", "^%", "^\\*+$", "(?i)^(password|passwd|pass|pwd|secret|changeme|example|xxx+|\\.\\.\\.)$"]
    },
    {
      "id": "password-assignment",
      "description": "password= in a connection string or config",
      "regex": "(?i)(?:^|[\\s;,{(&?\"'])(?:password|passwd|pwd)[\"']?\\s*[=:]\\s*[\"']?([^\\s\"';,&)}]{6,200})",
      "secret_group": 1,
      "allow": ["^\\$", "^\\{", "^<", "^%", "^\\*+$", "^os\\.", "^env\\(", "^process\\.env", "(?i)^(password|passwd|changeme|example|placeholder|redacted|none|null|undefined|xxxxxx+|your[_-]?password\\S*)$"]
    },
    {
      "id": "jwt",
      "description": "JSON web token",
      "regex": "\\b(eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})",
      "secret_group": 1,
      "allow": []
    }
  ]
}
