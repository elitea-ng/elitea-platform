# syntax=docker/dockerfile:1.7
#
# The cloud browser's session image (ADR-0049 decisions 2 and 4).
#
# One pod per browser session runs `elitea-browser-session`: the sandbox
# supervisor (#1595) starts the container with `idle` and execs `serve`,
# which speaks the agent line protocol on stdin/stdout
# (libs/proto/elitea/runtime/v1/browser_session_agent_v1.md) and drives the
# engine below over CDP on --remote-debugging-pipe. Nothing in the image
# listens on a port.
#
# The engine is chrome-headless-shell from Chrome for Testing at a pinned
# version, verified by SHA-256 per architecture. It moves only in a reviewed
# change: bump CFT_VERSION and both checksums together (from
# https://googlechromelabs.github.io/chrome-for-testing/ and a download of
# each zip), and the conformance job (ci-browser-session.yml) proves the new
# engine before merge.
#
# Debian 13 (trixie-slim): the engine links glib, NSS, ATK, X11/xcb and
# friends dynamically, so the runtime is a Debian userland rather than
# distroless, and its scan is exempt for the base's unfixed findings
# (.github/image-scan-exempt.txt). No shell is needed at run time but one is
# present in the base; the container runs as uid 10001 on a read-only root
# with memory-backed /tmp and /dev/shm (the supervisor's pod spec).
#
# Two images come out of this file (ADR-0049 decision 2, #1599):
#
#   full (the last stage, the default build): chrome-headless-shell only.
#   lite (--target lite): the same plus Moli (lexmount/moli, Apache-2.0 or
#     MIT) at /opt/moli/moli, pinned to MOLI_VERSION and verified by
#     SHA-256 per architecture. The session agent finds it there and runs
#     `lite` and `auto` sessions on it; Chrome stays in the image so `auto`
#     can move a session to it. The Moli pin moves only when the bake-off
#     corpus passes on the new version (deploy/browser-bakeoff,
#     browser-bakeoff.yml): bump MOLI_VERSION and both checksums together
#     (the release's asset digests, `gh api
#     repos/lexmount/moli/releases/tags/<tag>`).
#
# Build from the repository root:
#
#   podman build -f libs/rust/browser-session/Containerfile -t elitea-browser-session:dev .
#   podman build -f libs/rust/browser-session/Containerfile --target lite -t elitea-browser-session-lite:dev .

ARG CFT_VERSION=157.0.8103.38
ARG MOLI_VERSION=1.1.22

FROM rust:1.99.1-trixie@sha256:767c71592f7d1f3f242292000f8efd4e67b6732363da176772f4d220332e264f AS builder
ENV CARGO_NET_RETRY=10 \
    CARGO_NET_GIT_FETCH_WITH_CLI=true
WORKDIR /src
COPY libs/rust/ libs/rust/
# Workspace members compile platform-rpc's contracts at ../../proto and the
# tool category contract at ../../proto/contracts (see workspace-runner).
COPY libs/proto/elitea/ libs/proto/elitea/
COPY libs/proto/contracts/ libs/proto/contracts/
# A shared target cache judges path crates fresh by mtime: touch the context
# so this build compiles the agent from it (see the worker's Containerfile).
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/libs/rust/target,sharing=locked \
    find /src -type f -exec touch {} + && \
    cd libs/rust && \
    cargo build --release --locked -p elitea-browser-session && \
    install -D -m 0755 target/release/elitea-browser-session /out/elitea-browser-session

# The engine, fetched and verified in its own stage so curl and unzip never
# reach the runtime.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS engine
ARG CFT_VERSION
ARG TARGETARCH
RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl unzip && \
    rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) platform=linux64; sum=deafffa74660b34853a4119c361fd427ac8c9fcb62db51ddb8a797cd83a4ba2d ;; \
      arm64) platform=linux-arm64; sum=b9b910a57b2a15eb3e55000a2339f93a973934a413ebfc6e585a50ec6c42fd6c ;; \
      *) echo "no chrome-headless-shell for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --silent --show-error --location --retry 5 --retry-all-errors \
      -o /tmp/engine.zip \
      "https://storage.googleapis.com/chrome-for-testing-public/${CFT_VERSION}/${platform}/chrome-headless-shell-${platform}.zip"; \
    echo "${sum}  /tmp/engine.zip" | sha256sum -c -; \
    unzip -q /tmp/engine.zip -d /tmp/engine; \
    mv "/tmp/engine/chrome-headless-shell-${platform}" /opt/chrome-headless-shell; \
    test -x /opt/chrome-headless-shell/chrome-headless-shell; \
    echo "${CFT_VERSION}" > /opt/chrome-headless-shell/CFT_VERSION; \
    rm -rf /tmp/engine /tmp/engine.zip

# Moli, fetched and verified in its own stage like the engine above. The
# release tarball is data: it is unpacked, never run here.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS moli
ARG MOLI_VERSION
ARG TARGETARCH
RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) triple=x86_64-unknown-linux-gnu; sum=7e10f9a5b62371da56203b21ac0172bbe3c3626de189fc3742b91b2e2b8cdd39 ;; \
      arm64) triple=aarch64-unknown-linux-gnu; sum=a199802d237fff981cb5a72ac075813af2510f5a4b51ce182d8fc18b5520210b ;; \
      *) echo "no moli for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --silent --show-error --location --retry 5 --retry-all-errors \
      -o /tmp/moli.tar.gz \
      "https://github.com/lexmount/moli/releases/download/v${MOLI_VERSION}/moli-${triple}.tar.gz"; \
    echo "${sum}  /tmp/moli.tar.gz" | sha256sum -c -; \
    mkdir /tmp/moli; \
    tar -xzf /tmp/moli.tar.gz -C /tmp/moli --no-same-owner; \
    mv "/tmp/moli/moli-v${MOLI_VERSION}-${triple}" /opt/moli; \
    test -f /opt/moli/moli; \
    chmod 0755 /opt/moli/moli; \
    echo "${MOLI_VERSION}" > /opt/moli/MOLI_VERSION; \
    rm -rf /tmp/moli /tmp/moli.tar.gz

FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS runtime
# The engine's NEEDED libraries (readelf -d of chrome-headless-shell 157)
# and Chrome for Testing's deb.deps: fonts so text renders, CA roots for the
# TLS the engine terminates through the egress proxy's CONNECT tunnel.
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        ca-certificates fonts-liberation \
        libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 \
        libdbus-1-3 libexpat1 libgbm1 libglib2.0-0t64 libnspr4 libnss3 \
        libudev1 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 \
        libxfixes3 libxkbcommon0 libxrandr2 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=engine /opt/chrome-headless-shell/ /opt/chrome-headless-shell/
COPY --from=builder /out/elitea-browser-session /usr/local/bin/elitea-browser-session
# A library the engine needs and the image lacks fails the build here, not
# the first session in production.
RUN set -eu; \
    missing="$(ldd /opt/chrome-headless-shell/chrome-headless-shell | grep 'not found' || true)"; \
    if [ -n "${missing}" ]; then echo "${missing}" >&2; exit 1; fi; \
    groupadd --gid 10001 elitea; \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin elitea
USER 10001:10001
WORKDIR /tmp
ENV HOME=/tmp
ENTRYPOINT ["/usr/local/bin/elitea-browser-session"]
CMD ["idle"]

# The lite image: the full one plus Moli and its licences. A library Moli
# needs and the image lacks fails the build here.
FROM runtime AS lite
USER 0:0
COPY --from=moli /opt/moli/ /opt/moli/
RUN set -eu; \
    missing="$(ldd /opt/moli/moli | grep 'not found' || true)"; \
    if [ -n "${missing}" ]; then echo "${missing}" >&2; exit 1; fi
USER 10001:10001

# The full image stays the last stage, so a build without --target (publish,
# the conformance job) ships what it always has.
FROM runtime AS full
