{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elitea.runtime.http-action-invocation.v3",
  "title": "HTTP action invocation v3 (Worker to Main)",
  "description": "Worker sends canonical inputs only. Main renders the request from the frozen template. Replaces request_wire_b64 of schema elitea.runtime.http-action.v2. The schema_version value is a proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "thread_id",
    "step",
    "activation_id",
    "binding_digest",
    "inputs_b64",
    "inputs_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "elitea.runtime.http-action.v3"
    },
    "node_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "thread_id": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "activation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "inputs_b64": {
      "type": "string",
      "maxLength": 349528,
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "inputs_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "revision",
        "digest_sha256"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "revision": {
          "const": 1
        },
        "digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    }
  }
}
