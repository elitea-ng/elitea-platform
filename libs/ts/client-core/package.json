{
  "name": "@elitea/client-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript shared by the Elitea web, desktop and mobile clients: brand defaults, chat stream parsing, the conversation view model, the agent builder and the IT support line.",
  "type": "module",
  "exports": {
    "./agent-builder": "./src/agent-builder/index.ts",
    "./brand": "./src/brand/index.ts",
    "./conversation": "./src/conversation/index.ts",
    "./limits": "./src/limits/index.ts",
    "./stream":"./src/stream/index.ts",
    "./support": "./src/support/index.ts"
  },
  "scripts": {
    "test": "node --import ./test/register.mjs --test \"src/**/*.test.ts\"",
    "typecheck": "../../../apps/elitea-web/node_modules/.bin/tsc -p tsconfig.json",
    "gen": "node scripts/gen-brand.mjs",
    "check:generated": "node scripts/gen-brand.mjs --check"
  },
  "engines": {
    "node": ">=24"
  }
